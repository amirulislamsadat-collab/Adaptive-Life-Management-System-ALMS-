# Copy to .env and fill in for local dev (only needed if your MySQL isn't
# the XAMPP default of root / no password / port 3306) or for a real deploy.

# --- Database ---
# Leave unset for local XAMPP (defaults to 127.0.0.1:3306, root, no password, alms_db).
# Set all five when pointing at a cloud MySQL provider (e.g. Aiven) — this also
# switches the connection pool to use TLS, which cloud providers require.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# --- Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Google Sign-In (optional) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add this Authorized redirect URI:
#   <your deployed URL>/auth/google/callback   (e.g. https://your-app.vercel.app/auth/google/callback)
# Leave these unset to hide the "Continue with Google" button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-app.vercel.app/auth/google/callback

# --- AI Assistant (optional) ---
# Set ONE of these two (if both are set, Groq is used):
#   GROQ_API_KEY       - free tier, get one at https://console.groq.com/keys
#   ANTHROPIC_API_KEY   - higher quality, one-time free credit then paid,
#                         get one at https://console.anthropic.com/settings/keys
# Leave both unset to hide the assistant chat bubble entirely.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to llama-3.3-70b-versatile for
# Groq, claude-sonnet-5 for Anthropic).
ASSISTANT_MODEL=

# --- Push Notifications (optional) ---
# Generate a pair with: npx web-push generate-vapid-keys
# Leave unset to hide the Settings > Notifications toggle entirely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret Vercel automatically sends as `Authorization: Bearer <value>` on
# real cron invocations (see vercel.json's crons + /api/cron/notify) once
# this is set as a Vercel env var — set it to any long random string.
CRON_SECRET=
