{
  "name": "alms-desktop",
  "version": "1.0.0",
  "description": "ALMS — Adaptive Life Management System (Windows/Mac/Linux desktop app)",
  "main": "main.js",
  "author": "CSE470 Group 09",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cse470.alms",
    "productName": "ALMS",
    "directories": {
      "output": "dist"
    },
    "artifactName": "ALMS-Setup.${ext}",
    "files": [
      "main.js",
      "config.json",
      "build/icon.png"
    ],
    "protocols": {
      "name": "ALMS Auth Handoff",
      "schemes": ["alms"]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    }
  }
}
