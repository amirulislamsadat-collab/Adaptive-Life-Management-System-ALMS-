<%- include('header', { currentPath: '/dashboard' }) %>
<div class="page">
  <div class="greeting-card">
    <div class="greeting-left">
      <h1>Good <%= (new Date().getHours()<12?'Morning':new Date().getHours()<18?'Afternoon':'Evening') %>, <%= user.name.split(' ')[0] %>!</h1>
      <p>Here's everything that needs you today — nothing more.</p>
      <div class="role-badge"><i class="fas fa-user-circle" aria-hidden="true"></i> <%= user.role %></div>
    </div>
    <div class="date-display">
      <div class="date-day"><%= new Date().toLocaleDateString('en-US',{weekday:'long'}) %></div>
      <div class="date-full"><%= new Date().toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></div>
    </div>
  </div>

  <% if(streakInfo.currentStreak > 0 && !streakInfo.activeToday){ %>
  <div class="streak-risk-banner">
    <div class="streak-risk-icon"><i class="fas fa-fire" aria-hidden="true"></i></div>
    <div class="focus-banner-body">
      <div class="focus-banner-title">Your <%= streakInfo.currentStreak %>-day streak is at risk!</div>
      <div class="focus-banner-sub">Complete a task, check in a habit, or log anything to keep it alive today.</div>
    </div>
  </div>
  <% } %>

  <% if(today.activeFocus){ %>
  <div class="focus-banner">
    <div class="focus-banner-icon"><i class="fas fa-crosshairs" aria-hidden="true"></i></div>
    <div class="focus-banner-body">
      <div class="focus-banner-title">Focus session active — "<%= today.activeFocus.name %>"</div>
      <% if(today.activeFocus.blocklist){ %><div class="focus-banner-sub">Staying off: <%= today.activeFocus.blocklist %></div><% } %>
    </div>
    <a href="/focus" class="btn secondary btn-sm">Check in</a>
  </div>
  <% } %>

  <div class="checkin-card" id="checkinPromptCard" hidden>
    <div class="checkin-card-icon"><i class="fas fa-clipboard-check" aria-hidden="true"></i></div>
    <div class="checkin-card-body">
      <div class="checkin-card-title">How's today looking?</div>
      <div class="checkin-card-sub">A 30-second check-in: energy, water goal, and today's one focus. +15 XP.</div>
    </div>
    <button type="button" class="btn primary btn-sm" id="checkinStartBtn">Check In</button>
  </div>

  <div class="ios-install-modal" id="checkinModal" hidden>
    <div class="ios-install-box install-picker-box">
      <button type="button" class="ios-install-close" id="checkinModalClose" aria-label="Close">&times;</button>
      <div class="ios-install-icon"><i class="fas fa-clipboard-check" aria-hidden="true"></i></div>
      <h3>Daily Check-In</h3>
      <form id="checkinForm">
        <div class="fg">
          <label>Energy today</label>
          <div class="energy-picker">
            <% ['😴','😕','🙂','😃','🤩'].forEach(function(emoji, i){ %>
              <label class="energy-opt">
                <input type="radio" name="energy_level" value="<%= i+1 %>" <%= i===2?'checked':'' %>>
                <span><%= emoji %></span>
              </label>
            <% }) %>
          </div>
        </div>
        <div class="fg">
          <label>Water goal today: <span id="waterGoalValue"><%= today.waterGoal %></span> ml</label>
          <input type="range" name="water_goal_ml" id="waterGoalSlider" min="500" max="4000" step="250" value="<%= today.waterGoal %>" style="width:100%;">
        </div>
        <div class="fg">
          <label for="checkinFocus">Your one focus for today (optional)</label>
          <input type="text" id="checkinFocus" name="focus_text" placeholder="e.g. Finish the project proposal" maxlength="255">
        </div>
        <% if(enabledSlugs.indexOf('health') !== -1){ %>
          <a href="/mood/new" class="btn secondary btn-sm" style="width:100%;justify-content:center;margin-bottom:14px;"><i class="fas fa-smile" aria-hidden="true"></i> Also log today's mood</a>
        <% } %>
        <button type="submit" class="btn primary" style="width:100%;" id="checkinSubmitBtn">Complete Check-In</button>
      </form>
    </div>
  </div>

  <form class="quick-add-bar" method="POST" action="/tasks/quick-add" id="quickAddForm">
    <i class="fas fa-plus quick-add-icon" aria-hidden="true"></i>
    <input type="text" name="text" placeholder='Quick-add a task — try "buy groceries tomorrow high priority"' autocomplete="off">
    <button type="submit" class="btn primary btn-sm">Add</button>
  </form>

  <div class="section-header" style="margin-top:36px;">
    <div class="section-title"><i class="fas fa-sun" aria-hidden="true"></i> Today</div>
    <button type="button" class="manage-btn" id="customizeWidgetsBtn"><i class="fas fa-sliders-h" aria-hidden="true"></i> Customize</button>
  </div>

  <div class="widget-customize-panel" id="widgetCustomizePanel" hidden>
    <div class="widget-customize-hint">Drag cards below to reorder. Toggle to show/hide.</div>
    <div id="widgetToggleList"></div>
  </div>

  <div class="today-grid" id="todayGrid">

    <% if(today.tasksDue.length){ %>
    <div class="today-card" data-widget-key="tasks" draggable="true">
      <div class="today-card-head"><i class="fas fa-grip-vertical widget-drag-handle" aria-hidden="true"></i><i class="fas fa-tasks" aria-hidden="true"></i> Tasks due today</div>
      <% today.tasksDue.forEach(t => { %>
      <div class="today-row">
        <span><%= t.title %></span>
        <form method="POST" action="/tasks/done/<%= t.id %>"><button class="today-check-btn" title="Mark done"><i class="fas fa-check" aria-hidden="true"></i></button></form>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if(today.habitsToCheckIn.length){ %>
    <div class="today-card" data-widget-key="habits" draggable="true">
      <div class="today-card-head"><i class="fas fa-grip-vertical widget-drag-handle" aria-hidden="true"></i><i class="fas fa-fire" aria-hidden="true"></i> Habits to check in</div>
      <% today.habitsToCheckIn.forEach(h => { %>
      <div class="today-row">
        <span><%= h.name %> <span class="streak-badge <%= h.currentStreak === 0 ? 'zero' : '' %>" style="margin-left:6px;"><%= h.currentStreak %>🔥</span></span>
        <form method="POST" action="/habits/checkin/<%= h.id %>"><button class="today-check-btn" title="Check in"><i class="fas fa-check" aria-hidden="true"></i></button></form>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if(today.medsDueToday.length){ %>
    <div class="today-card" data-widget-key="meds" draggable="true">
      <div class="today-card-head"><i class="fas fa-grip-vertical widget-drag-handle" aria-hidden="true"></i><i class="fas fa-pills" aria-hidden="true"></i> Medications today</div>
      <% today.medsDueToday.forEach(m => { %>
      <div class="today-row">
        <span><%= m.medication_name %></span>
        <span class="meta"><%= m.time_of_day.slice(0,5) %></span>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if(today.remindersDue.length){ %>
    <div class="today-card" data-widget-key="reminders" draggable="true">
      <div class="today-card-head"><i class="fas fa-grip-vertical widget-drag-handle" aria-hidden="true"></i><i class="fas fa-clock" aria-hidden="true"></i> Reminders due</div>
      <% today.remindersDue.forEach(r => { %>
      <div class="today-row"><span><%= r.title %></span></div>
      <% }) %>
    </div>
    <% } %>

    <% if(today.todaysEvents.length){ %>
    <div class="today-card" data-widget-key="events" draggable="true">
      <div class="today-card-head"><i class="fas fa-grip-vertical widget-drag-handle" aria-hidden="true"></i><i class="fas fa-calendar-alt" aria-hidden="true"></i> Today's events</div>
      <% today.todaysEvents.forEach(e => { %>
      <div class="today-row">
        <span><%= e.title %></span>
        <span class="meta"><%= new Date(e.start_time).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}) %></span>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if(enabledSlugs.indexOf('health') !== -1){ %>
    <div class="today-card" data-widget-key="water" draggable="true">
      <div class="today-card-head"><i class="fas fa-grip-vertical widget-drag-handle" aria-hidden="true"></i><i class="fas fa-tint" aria-hidden="true"></i> Water intake</div>
      <div class="progress-track" style="margin:8px 0;"><div class="progress-fill" style="width:<%= Math.min(100, Math.round(today.waterTotal/today.waterGoal*100)) %>%"></div></div>
      <div class="today-row">
        <span class="meta"><%= today.waterTotal %> / <%= today.waterGoal %> ml</span>
        <form method="POST" action="/water/create">
          <input type="hidden" name="log_date" value="<%= new Date().toISOString().slice(0,10) %>">
          <input type="hidden" name="amount_ml" value="250">
          <button class="today-check-btn" title="+250ml"><i class="fas fa-plus" aria-hidden="true"></i></button>
        </form>
      </div>
    </div>
    <% } %>

  </div>
  <% if(!today.tasksDue.length && !today.habitsToCheckIn.length && !today.medsDueToday.length && !today.remindersDue.length && !today.todaysEvents.length){ %>
  <p class="empty-msg">Nothing urgent today — you're all caught up. 🎉</p>
  <% } %>

  <div class="stats-grid" style="margin-top:40px;">
    <div class="stat-card">
      <div class="stat-icon total">
        <i class="fas fa-layer-group" aria-hidden="true"></i>
      </div>
      <div class="stat-info">
        <div class="stat-val"><%= stats.total %></div>
        <div class="stat-label">Total Tasks</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon completed">
        <i class="fas fa-check-circle" aria-hidden="true"></i>
      </div>
      <div class="stat-info">
        <div class="stat-val"><%= stats.completed %></div>
        <div class="stat-label">Completed</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon pending">
        <i class="fas fa-hourglass-half" aria-hidden="true"></i>
      </div>
      <div class="stat-info">
        <div class="stat-val"><%= stats.pending %></div>
        <div class="stat-label">Pending</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon high">
        <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
      </div>
      <div class="stat-info">
        <div class="stat-val"><%= stats.high_priority %></div>
        <div class="stat-label">High Priority</div>
      </div>
    </div>
  </div>

  <div class="section-header" style="margin-top:40px;">
    <div class="section-title">
      <i class="fas fa-th-large" aria-hidden="true"></i>
      Active Modules <span class="section-badge"><%= modules.length %></span>
    </div>
    <a href="/modules/settings" class="manage-btn"><i class="fas fa-cog" aria-hidden="true"></i> Manage</a>
  </div>

  <% if(modules && modules.length){ %>
  <div class="modules-grid">
    <% modules.forEach(function(mod){ %>
    <% const linkMap = { tasks:'/tasks/hub', notes:'/notes', calendar:'/calendar', reminders:'/reminders', alarms:'/alarms', subjects:'/subjects', study:'/modules/study', finance:'/modules/finance', health:'/modules/health', journal:'/journal', habits:'/habits', screentime:'/modules/screentime', goals:'/goals', reports:'/modules/reports', focus:'/focus' }; %>
    <% const iconMap = { tasks:'fas fa-tasks', study:'fas fa-book-open', finance:'fas fa-wallet', health:'fas fa-heartbeat', journal:'fas fa-pen', notes:'fas fa-sticky-note', calendar:'fas fa-calendar-alt', reminders:'fas fa-clock', alarms:'fas fa-bell', subjects:'fas fa-book', habits:'fas fa-fire', screentime:'fas fa-mobile-alt', goals:'fas fa-bullseye', reports:'fas fa-chart-line', focus:'fas fa-crosshairs' }; %>
    <% const link = linkMap[mod.slug] || '/modules/settings'; %>
    <% const icon = iconMap[mod.slug] || 'fas fa-cube'; %>
    <a href="<%= link %>" class="module-card" aria-label="<%= mod.name %> module">
      <div class="module-header">
        <div class="module-icon">
          <i class="<%= icon %>" aria-hidden="true"></i>
        </div>
        <div>
          <div class="module-title"><%= mod.name %></div>
        </div>
      </div>
      <p class="module-desc"><%= mod.description %></p>
      <div class="module-footer">
        <div class="status-dot"></div> Active
      </div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="empty-msg">No active workspaces. <a href="/modules/settings">Enable some modules</a> to get started.</p>
  <% } %>

  <div class="action-buttons">
    <a href="/tasks/new" class="btn primary" id="newTaskBtn">
      <i class="fas fa-plus" aria-hidden="true"></i> New Task
    </a>
    <a href="/tasks/hub" class="btn secondary" id="viewTasksBtn">
      <i class="fas fa-list" aria-hidden="true"></i> View All Tasks
    </a>
  </div>
</div>
<script>
(function() {
  function localDateStr() {
    var d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  var today = localDateStr();
  var promptCard = document.getElementById('checkinPromptCard');
  var modal = document.getElementById('checkinModal');
  var startBtn = document.getElementById('checkinStartBtn');
  var closeBtn = document.getElementById('checkinModalClose');
  var form = document.getElementById('checkinForm');
  var slider = document.getElementById('waterGoalSlider');
  var sliderValue = document.getElementById('waterGoalValue');
  if (!promptCard || !modal) return;

  fetch('/checkin/status?date=' + today)
    .then(function(r) { return r.json(); })
    .then(function(data) { promptCard.hidden = !!data.completed; })
    .catch(function() {});

  slider.addEventListener('input', function() { sliderValue.textContent = slider.value; });
  startBtn.addEventListener('click', function() { modal.hidden = false; });
  closeBtn.addEventListener('click', function() { modal.hidden = true; });

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var submitBtn = document.getElementById('checkinSubmitBtn');
    submitBtn.disabled = true;
    fetch('/checkin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        checkin_date: today,
        energy_level: form.energy_level.value,
        water_goal_ml: slider.value,
        focus_text: document.getElementById('checkinFocus').value
      })
    })
      .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
      .then(function(res) {
        if (!res.ok) { window.almsToast(res.data.error || 'Something went wrong.', true); submitBtn.disabled = false; return; }
        modal.hidden = true;
        promptCard.hidden = true;
        var msg = res.data.note + ' (+' + res.data.xpAwarded + ' XP)';
        if (res.data.leveledUp) msg += ' — 🎉 Level up! You\'re now Level ' + res.data.newLevel + ': ' + res.data.newTitle;
        window.almsToast(msg, false);
        setTimeout(function() { location.reload(); }, 2200);
      })
      .catch(function() { window.almsToast("Couldn't save your check-in — check your connection and try again.", true); submitBtn.disabled = false; });
  });
})();
</script>
<script id="widgetLayoutData" type="application/json"><%- JSON.stringify(widgetLayout) %></script>
<script>
(function() {
  var WIDGET_LABELS = { tasks: 'Tasks due today', habits: 'Habits to check in', meds: 'Medications today', reminders: 'Reminders due', events: "Today's events", water: 'Water intake' };
  var grid = document.getElementById('todayGrid');
  var toggleList = document.getElementById('widgetToggleList');
  var customizeBtn = document.getElementById('customizeWidgetsBtn');
  var customizePanel = document.getElementById('widgetCustomizePanel');
  if (!grid) return;

  var layout;
  try { layout = JSON.parse(document.getElementById('widgetLayoutData').textContent) || []; } catch (e) { layout = []; }

  function saveLayout() {
    fetch('/dashboard/widgets', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ layout: layout })
    }).catch(function() {});
  }

  function applyLayout() {
    // Reorder existing cards to match saved order; cards for widgets with
    // no data today simply aren't in the DOM at all, so this only ever
    // touches what's actually present.
    layout.forEach(function(w) {
      var card = grid.querySelector('[data-widget-key="' + w.key + '"]');
      if (card) {
        grid.appendChild(card);
        card.hidden = !w.visible;
      }
    });
  }

  function renderToggleList() {
    toggleList.innerHTML = '';
    layout.forEach(function(w) {
      var present = !!grid.querySelector('[data-widget-key="' + w.key + '"]');
      var row = document.createElement('label');
      row.className = 'widget-toggle-row';
      row.innerHTML = '<input type="checkbox" ' + (w.visible ? 'checked' : '') + (present ? '' : ' disabled') + '> ' +
        (WIDGET_LABELS[w.key] || w.key) + (present ? '' : ' <small>(nothing to show today)</small>');
      row.querySelector('input').addEventListener('change', function(e) {
        w.visible = e.target.checked;
        applyLayout();
        saveLayout();
      });
      toggleList.appendChild(row);
    });
  }

  applyLayout();

  if (customizeBtn) {
    customizeBtn.addEventListener('click', function() {
      customizePanel.hidden = !customizePanel.hidden;
      if (!customizePanel.hidden) renderToggleList();
    });
  }

  // Native HTML5 drag-and-drop reordering.
  var dragged = null;
  grid.addEventListener('dragstart', function(e) {
    var card = e.target.closest('.today-card');
    if (!card) return;
    dragged = card;
    card.classList.add('dragging');
  });
  grid.addEventListener('dragend', function(e) {
    var card = e.target.closest('.today-card');
    if (card) card.classList.remove('dragging');
  });
  grid.addEventListener('dragover', function(e) {
    e.preventDefault();
    var over = e.target.closest('.today-card');
    if (!over || over === dragged || !dragged) return;
    var rect = over.getBoundingClientRect();
    var before = (e.clientY - rect.top) < rect.height / 2;
    grid.insertBefore(dragged, before ? over : over.nextSibling);
  });
  grid.addEventListener('drop', function(e) {
    e.preventDefault();
    if (!dragged) return;
    var newOrder = Array.prototype.slice.call(grid.querySelectorAll('.today-card')).map(function(c) { return c.getAttribute('data-widget-key'); });
    layout.sort(function(a, b) { return newOrder.indexOf(a.key) - newOrder.indexOf(b.key); });
    dragged = null;
    saveLayout();
  });
})();
</script>
<%- include('footer') %>
