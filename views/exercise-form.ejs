<%- include('header', { currentPath: '/exercise' }) %>
<div class="page page-center">
  <a href="/exercise" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Exercise Tracking</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= log ? 'edit' : 'running' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="exerciseForm">
      <div class="form-row">
        <div class="fg">
          <label for="exDate">Date <span class="required">*</span></label>
          <input id="exDate" type="date" name="log_date" required value="<%= log ? new Date(log.log_date).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="fg">
          <label for="exActivity">Activity <span class="required">*</span></label>
          <input id="exActivity" type="text" name="activity_type" required placeholder="e.g. Running, Cycling, Gym" value="<%= log ? log.activity_type : '' %>">
        </div>
      </div>
      <div class="fg">
        <label for="exDuration">Duration: <span class="live-val" id="exDurationVal"><%= log ? log.duration_minutes : 30 %></span> min <span class="required">*</span></label>
        <div class="quick-chip-row">
          <button type="button" class="quick-chip" data-target="exDuration" data-val="15">15 min</button>
          <button type="button" class="quick-chip" data-target="exDuration" data-val="30">30 min</button>
          <button type="button" class="quick-chip" data-target="exDuration" data-val="45">45 min</button>
          <button type="button" class="quick-chip" data-target="exDuration" data-val="60">60 min</button>
        </div>
        <input id="exDuration" type="range" name="duration_minutes" min="5" max="180" step="5" required value="<%= log ? log.duration_minutes : 30 %>" class="range-slider" data-live-label="exDurationVal">
        <div class="slider-minmax"><span>5 min</span><span>3 hrs</span></div>
      </div>
      <div class="fg">
        <label>Intensity</label>
        <div class="pill-picker">
          <input type="radio" id="intLight" name="intensity" value="light" <%= log && log.intensity==='light' ? 'checked' : '' %>>
          <label class="pill-option" for="intLight"><span class="pill-emoji">🚶</span> Light</label>
          <input type="radio" id="intModerate" name="intensity" value="moderate" <%= !log || log.intensity==='moderate' ? 'checked' : '' %>>
          <label class="pill-option" for="intModerate"><span class="pill-emoji">🏃</span> Moderate</label>
          <input type="radio" id="intIntense" name="intensity" value="intense" <%= log && log.intensity==='intense' ? 'checked' : '' %>>
          <label class="pill-option" for="intIntense"><span class="pill-emoji">🔥</span> Intense</label>
        </div>
      </div>
      <div class="fg">
        <label for="exCalories">Calories Burned (optional): <span class="live-val" id="exCaloriesVal"><%= log && log.calories_burned ? log.calories_burned : 0 %></span></label>
        <input id="exCalories" type="range" name="calories_burned" min="0" max="1000" step="10" value="<%= log && log.calories_burned ? log.calories_burned : 0 %>" class="range-slider" data-live-label="exCaloriesVal">
        <div class="slider-minmax"><span>0</span><span>1000</span></div>
      </div>
      <div class="fg">
        <label for="exNotes">Notes</label>
        <textarea id="exNotes" name="notes" placeholder="How did it feel? Any details worth remembering..." rows="3"><%= log ? log.notes || '' : '' %></textarea>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/exercise" id="cancelExerciseBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveExerciseBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Exercise Log</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
