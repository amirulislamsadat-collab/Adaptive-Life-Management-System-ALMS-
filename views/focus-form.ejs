<%- include('header', { currentPath: '/focus' }) %>
<%
  const selectedDays = session && session.days_of_week ? session.days_of_week.split(',') : ['MO','TU','WE','TH','FR'];
%>
<div class="page page-center">
  <a href="/focus" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Focus Mode</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= session ? 'edit' : 'crosshairs' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="focusForm">
      <div class="fg">
        <label for="fName">Session Name <span class="required">*</span></label>
        <input id="fName" type="text" name="name" required placeholder="e.g. Deep Work, Evening Wind-Down" value="<%= session ? session.name : '' %>">
      </div>
      <div class="form-row">
        <div class="fg">
          <label for="fStart">Start Time <span class="required">*</span></label>
          <input id="fStart" type="time" name="start_time" required value="<%= session ? session.start_time.slice(0,5) : '09:00' %>">
        </div>
        <div class="fg">
          <label for="fEnd">End Time <span class="required">*</span></label>
          <input id="fEnd" type="time" name="end_time" required value="<%= session ? session.end_time.slice(0,5) : '11:00' %>">
        </div>
      </div>
      <div class="fg">
        <label>Repeat on</label>
        <div class="days-grid">
          <% ['MO','TU','WE','TH','FR','SA','SU'].forEach(day => { %>
            <label class="day-checkbox">
              <input type="checkbox" name="days_of_week" value="<%= day %>" <%= selectedDays.includes(day) ? 'checked' : '' %>>
              <span class="day-label"><%= day %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <div class="fg">
        <label for="fBlocklist">What are you avoiding? (optional)</label>
        <input id="fBlocklist" type="text" name="blocklist" placeholder="e.g. Instagram, YouTube, TikTok" value="<%= session ? session.blocklist || '' : '' %>">
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/focus" id="cancelFocusBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveFocusBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Focus Session</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
