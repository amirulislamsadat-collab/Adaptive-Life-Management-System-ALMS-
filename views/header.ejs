        </div>
        <div class="command-palette-list" id="commandPaletteList">
          <a href="/dashboard"><i class="fas fa-th-large" aria-hidden="true"></i> Dashboard</a>
          <% if(enabledSlugs.indexOf('tasks') !== -1){ %><a href="/tasks/hub"><i class="fas fa-tasks" aria-hidden="true"></i> Tasks</a><% } %>
          <% if(enabledSlugs.indexOf('notes') !== -1){ %><a href="/notes"><i class="fas fa-sticky-note" aria-hidden="true"></i> Notes</a><% } %>
          <% if(enabledSlugs.indexOf('calendar') !== -1){ %><a href="/calendar"><i class="fas fa-calendar-alt" aria-hidden="true"></i> Calendar</a><% } %>
          <% if(enabledSlugs.indexOf('reminders') !== -1){ %><a href="/reminders"><i class="fas fa-clock" aria-hidden="true"></i> Reminders</a><% } %>
          <% if(enabledSlugs.indexOf('alarms') !== -1){ %><a href="/alarms"><i class="fas fa-bell" aria-hidden="true"></i> Alarms</a><% } %>
          <% if(enabledSlugs.indexOf('subjects') !== -1){ %><a href="/subjects"><i class="fas fa-book" aria-hidden="true"></i> Subjects</a><% } %>
          <% if(enabledSlugs.indexOf('study') !== -1){ %>
          <a href="/assignments"><i class="fas fa-file-signature" aria-hidden="true"></i> Assignments</a>
          <a href="/exams"><i class="fas fa-graduation-cap" aria-hidden="true"></i> Examinations</a>
          <a href="/study-sessions"><i class="fas fa-stopwatch" aria-hidden="true"></i> Study Sessions</a>
          <% } %>
          <% if(enabledSlugs.indexOf('health') !== -1){ %>
          <a href="/sleep"><i class="fas fa-bed" aria-hidden="true"></i> Sleep</a>
          <a href="/water"><i class="fas fa-tint" aria-hidden="true"></i> Water Intake</a>
          <a href="/exercise"><i class="fas fa-running" aria-hidden="true"></i> Exercise</a>
          <a href="/mood"><i class="fas fa-smile" aria-hidden="true"></i> Mood</a>
          <a href="/medications"><i class="fas fa-pills" aria-hidden="true"></i> Medications</a>
          <% } %>
          <% if(enabledSlugs.indexOf('habits') !== -1){ %><a href="/habits"><i class="fas fa-fire" aria-hidden="true"></i> Habits</a><% } %>
          <% if(enabledSlugs.indexOf('focus') !== -1){ %><a href="/focus"><i class="fas fa-crosshairs" aria-hidden="true"></i> Focus Mode</a><% } %>
          <% if(enabledSlugs.indexOf('screentime') !== -1){ %>
          <a href="/screen-time"><i class="fas fa-hourglass-half" aria-hidden="true"></i> Screen Time</a>
          <a href="/social-media"><i class="fas fa-hashtag" aria-hidden="true"></i> Social Media</a>
          <% } %>
          <% if(enabledSlugs.indexOf('finance') !== -1){ %>
          <a href="/expenses"><i class="fas fa-money-bill-wave" aria-hidden="true"></i> Expenses</a>
          <a href="/savings-goals"><i class="fas fa-piggy-bank" aria-hidden="true"></i> Savings Goals</a>
          <% } %>
          <% if(enabledSlugs.indexOf('goals') !== -1){ %><a href="/goals"><i class="fas fa-bullseye" aria-hidden="true"></i> Goals</a><% } %>
          <% if(enabledSlugs.indexOf('journal') !== -1){ %><a href="/journal"><i class="fas fa-pen" aria-hidden="true"></i> Journal</a><% } %>
          <% if(enabledSlugs.indexOf('reports') !== -1){ %><a href="/modules/reports"><i class="fas fa-chart-line" aria-hidden="true"></i> Reports</a><% } %>
          <a href="/modules/settings"><i class="fas fa-cog" aria-hidden="true"></i> Settings</a>
        </div>
      </div>
    </div>

    <div class="ios-install-modal" id="installPickerModal" hidden>
      <div class="ios-install-box install-picker-box">
        <button type="button" class="ios-install-close" id="installPickerClose" aria-label="Close">&times;</button>
        <div class="ios-install-icon"><i class="fas fa-download" aria-hidden="true"></i></div>
        <h3>Get ALMS as an app</h3>
        <p class="install-picker-sub">Pick what fits how you use ALMS — the browser install auto-updates itself; the downloads below are standalone installers.</p>
        <div class="install-picker-options">
          <button type="button" class="install-picker-opt" id="installPickerBrowser" hidden>
            <i class="fas fa-globe" aria-hidden="true"></i>
            <span><strong>Install in this browser</strong><small>One click, updates automatically</small></span>
          </button>
          <button type="button" class="install-picker-opt" id="installPickerIOS" hidden>
            <i class="fas fa-mobile-alt" aria-hidden="true"></i>
            <span><strong>Add to Home Screen</strong><small>Instructions for iPhone/iPad</small></span>
          </button>
          <a class="install-picker-opt" href="https://github.com/amirulislamsadat-collab/Adaptive-Life-Management-System-ALMS-/releases/latest/download/ALMS-Setup.exe">
            <i class="fab fa-windows" aria-hidden="true"></i>
            <span><strong>Download for Windows</strong><small>.exe installer — unsigned, SmartScreen will warn once</small></span>
          </a>
          <a class="install-picker-opt" href="https://github.com/amirulislamsadat-collab/Adaptive-Life-Management-System-ALMS-/releases/latest/download/ALMS.apk">
            <i class="fab fa-android" aria-hidden="true"></i>
            <span><strong>Download for Android</strong><small>.apk — enable "install unknown apps" for your browser</small></span>
          </a>
        </div>
      </div>
    </div>

    <div class="ios-install-modal" id="iosInstallModal" hidden>
      <div class="ios-install-box">
        <button type="button" class="ios-install-close" id="iosInstallModalClose" aria-label="Close">&times;</button>
        <div class="ios-install-icon"><i class="fas fa-mobile-alt" aria-hidden="true"></i></div>
        <h3>Install ALMS on iPhone/iPad</h3>
        <ol>
          <li>Tap the <strong>Share</strong> button <i class="fas fa-arrow-up-from-bracket" aria-hidden="true"></i> in Safari's toolbar</li>
          <li>Scroll down and tap <strong>Add to Home Screen</strong></li>
          <li>Tap <strong>Add</strong> — ALMS now opens like a native app</li>
        </ol>
      </div>
    </div>

    <% if(assistantConfigured){ %>
    <button type="button" class="assistant-fab" id="assistantFab" aria-label="Open AI assistant">
      <i class="fas fa-robot" aria-hidden="true"></i>
    </button>
    <div class="assistant-panel" id="assistantPanel" hidden>
      <div class="assistant-head">
        <div class="assistant-head-title"><i class="fas fa-robot" aria-hidden="true"></i> ALMS Assistant</div>
        <button type="button" class="assistant-close" id="assistantClose" aria-label="Close">&times;</button>
      </div>
      <div class="assistant-messages" id="assistantMessages">
        <div class="assistant-msg assistant-msg-bot">Hi! I can help you find or understand any feature in ALMS — ask me anything about how the app works.</div>
      </div>
      <form class="assistant-input-row" id="assistantForm">
        <input type="text" id="assistantInput" placeholder="Ask about ALMS..." autocomplete="off" maxlength="2000">
        <button type="submit" class="assistant-send" aria-label="Send"><i class="fas fa-paper-plane" aria-hidden="true"></i></button>
      </form>
    </div>
    <% } %>
<% } %>

<% if(setupDone && dueNotifications && dueNotifications.length){ %>
<div class="flash-wrap" id="notifBanner">
  <div class="flash flash-warning" role="alert">
    <i class="fas fa-bell" aria-hidden="true"></i>
    <strong>You have <%= dueNotifications.length %> due notification(s):</strong>
    <% dueNotifications.slice(0, 3).forEach(function(item, idx){ %>
      <span><%= idx ? ' &nbsp;|&nbsp; ' : '&nbsp;' %><i class="fas fa-<%= item.type === 'alarm' ? 'bell' : 'clock' %>" aria-hidden="true"></i> <%= item.title %></span>
    <% }) %>
  </div>
</div>
<% } %>

<% if(success){ %>
<div class="flash-wrap"><div class="flash flash-success" role="status"><i class="fas fa-check-circle" aria-hidden="true"></i> <%- success %></div></div>
<% } %>
<% if(error){ %>
<div class="flash-wrap"><div class="flash flash-error" role="alert"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> <%- error %></div></div>
<% } %>

<% if(setupDone){ %>
<script>
(function() {
  var sidebar = document.querySelector('.sidebar');

  // Sidebar toggle (mobile / narrow viewports) — temporary overlay
  var menuBtn = document.getElementById('topbarMenuBtn');
  if (menuBtn) {
    menuBtn.addEventListener('click', function() {
      sidebar.classList.toggle('open');
    });
  }
  document.addEventListener('click', function(e) {
    if (!sidebar || !sidebar.classList.contains('open')) return;
    if (sidebar.contains(e.target) || e.target === menuBtn || (e.target.closest && e.target.closest('#topbarMenuBtn'))) return;
    sidebar.classList.remove('open');
  });

  // Hide / show sidebar — persists across page loads via localStorage
  var hideBtn = document.getElementById('sidebarHideBtn');
  var showBtn = document.getElementById('sidebarShowBtn');
  function setSidebarHidden(hidden) {
    document.body.classList.toggle('sidebar-hidden', hidden);
    try { localStorage.setItem('alms_sidebar_hidden', hidden ? '1' : '0'); } catch (e) {}
  }
  if (hideBtn) hideBtn.addEventListener('click', function() { setSidebarHidden(true); });
  if (showBtn) showBtn.addEventListener('click', function() { setSidebarHidden(false); });

  // Request browser notification permission
  if ("Notification" in window && Notification.permission === "default") {
    Notification.requestPermission();
  }

  // Show native browser notifications for due items
  <% if(typeof dueNotifications !== 'undefined' && dueNotifications && dueNotifications.length){ %>
    if ("Notification" in window && Notification.permission === "granted") {
      <% dueNotifications.forEach(function(item){ %>
        new Notification("ALMS <%= item.type === 'alarm' ? 'Alarm' : 'Reminder' %>", {
          body: "<%= item.title %> — due at <%= item.time %>",
          icon: "/favicon.ico"
        });
      <% }) %>
    }
  <% } %>

  // Client-side polling: check for new notifications every 60 seconds
  // without requiring a full page refresh
  function pollNotifications() {
    fetch('/api/notifications')
      .then(function(r){ return r.json(); })
      .then(function(data) {
        var chip = document.getElementById('notifChip');
        var banner = document.getElementById('notifBanner');
        if (data && data.count > 0) {
          if (chip) {
            chip.style.display = 'flex';
            var countEl = chip.querySelector('#notifCount');
            if (countEl) countEl.textContent = data.count;
            else chip.innerHTML = '<i class="fas fa-bell"></i> ' + data.count + ' due';
          }
          if (!banner && data.items && data.items.length) {
            var wrap = document.createElement('div');
            wrap.className = 'flash-wrap';
            wrap.id = 'notifBanner';
            var msg = data.items.slice(0,3).map(function(i){
              return '<i class="fas fa-' + (i.type==='alarm'?'bell':'clock') + '"></i> ' + i.title;
            }).join(' &nbsp;|&nbsp; ');
            wrap.innerHTML = '<div class="flash flash-warning" role="alert"><i class="fas fa-bell"></i> <strong>' + data.count + ' notification(s):</strong> ' + msg + '</div>';
            var topbar = document.querySelector('.topbar');
            if (topbar) topbar.insertAdjacentElement('afterend', wrap);
          }
          if ("Notification" in window && Notification.permission === "granted") {
            data.items.forEach(function(item) {
              new Notification("ALMS " + (item.type === 'alarm' ? 'Alarm' : 'Reminder'), {
                body: item.title + " — due at " + item.time,
                icon: "/favicon.ico"
              });
            });
          }
        }
      })
      .catch(function(){});
  }

  // Poll every 60 seconds
  setInterval(pollNotifications, 60000);
})();
</script>
<script src="/js/app.js" defer></script>
<% } %>
