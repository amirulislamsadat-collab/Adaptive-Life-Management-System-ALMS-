<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="ALMS - Adaptive Life Management System. Tasks, habits, health, finances, and focus — one adaptive workspace for your whole life.">
<title>ALMS — Adaptive Life Management System</title>
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#FF5A5F">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="ALMS">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="icon" href="/icons/icon-192.png">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<script>
// Applied immediately (before the rest of the page renders) so neither the
// sidebar's hidden state nor the dark theme flash visible-then-changed on
// every page load.
if (localStorage.getItem('alms_sidebar_hidden') === '1') {
  document.body.classList.add('sidebar-hidden');
}
var savedTheme = localStorage.getItem('alms_theme');
if (savedTheme === 'dark') {
  document.documentElement.setAttribute('data-theme', 'dark');
}
</script>
<% var setupDone = user && user.setup_completed == 1; %>
<% if(setupDone){ %>
<%
  var cp = typeof currentPath !== 'undefined' ? currentPath : '';
  var studyActive   = cp.indexOf('/modules/study') === 0 || cp.indexOf('/assignments') === 0 || cp.indexOf('/exams') === 0 || cp.indexOf('/study-sessions') === 0;
  var healthActive  = cp.indexOf('/modules/health') === 0 || cp.indexOf('/sleep') === 0 || cp.indexOf('/water') === 0 || cp.indexOf('/exercise') === 0 || cp.indexOf('/mood') === 0 || cp.indexOf('/medications') === 0;
  var digitalActive = cp.indexOf('/modules/screentime') === 0 || cp.indexOf('/screen-time') === 0 || cp.indexOf('/social-media') === 0;
  var financeActive = cp.indexOf('/modules/finance') === 0 || cp.indexOf('/expenses') === 0 || cp.indexOf('/savings-goals') === 0;
%>
<button type="button" class="sidebar-show-btn" id="sidebarShowBtn" aria-label="Show sidebar" title="Show sidebar">
  <i class="fas fa-bars" aria-hidden="true"></i>
</button>
<div class="app-shell">
  <aside class="sidebar" aria-label="Main navigation">
    <div class="nav-brand-row">
      <a href="/dashboard" class="nav-brand" aria-label="ALMS Home">
        <div class="nav-logo"><i class="fas fa-infinity" aria-hidden="true"></i></div>
        ALMS
      </a>
      <button type="button" class="sidebar-hide-btn" id="sidebarHideBtn" aria-label="Hide sidebar" title="Hide sidebar">
        <i class="fas fa-angles-left" aria-hidden="true"></i>
      </button>
    </div>
    <nav class="nav-links" id="sidebarNav">
      <li><a href="/dashboard" class="<%= cp === '/dashboard' ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-th-large" aria-hidden="true"></i></span> Dashboard</a></li>
      <% if(enabledSlugs.indexOf('tasks') !== -1){ %>
      <li><a href="/tasks/hub" class="<%= cp.indexOf('/tasks') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-tasks" aria-hidden="true"></i></span> Tasks</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('notes') !== -1){ %>
      <li><a href="/notes" class="<%= cp.indexOf('/notes') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-sticky-note" aria-hidden="true"></i></span> Notes</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('calendar') !== -1){ %>
      <li><a href="/calendar" class="<%= cp.indexOf('/calendar') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-calendar-alt" aria-hidden="true"></i></span> Calendar</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('reminders') !== -1){ %>
      <li><a href="/reminders" class="<%= cp.indexOf('/reminders') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-clock" aria-hidden="true"></i></span> Reminders</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('alarms') !== -1){ %>
      <li><a href="/alarms" class="<%= cp.indexOf('/alarms') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-bell" aria-hidden="true"></i></span> Alarms</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('subjects') !== -1){ %>
      <li><a href="/subjects" class="<%= cp.indexOf('/subjects') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-book" aria-hidden="true"></i></span> Subjects</a></li>
      <% } %>

      <% if(enabledSlugs.indexOf('study') !== -1){ %>
      <li class="nav-group">
        <details <%= studyActive ? 'open' : '' %>>
          <summary class="<%= studyActive ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-book-open" aria-hidden="true"></i></span> Study Planner <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i></summary>
          <ul class="nav-subgroup">
            <li><a href="/modules/study" class="<%= cp.indexOf('/modules/study') === 0 ? 'active' : '' %>">Overview</a></li>
            <li><a href="/assignments" class="<%= cp.indexOf('/assignments') === 0 ? 'active' : '' %>">Assignments</a></li>
            <li><a href="/exams" class="<%= cp.indexOf('/exams') === 0 ? 'active' : '' %>">Examinations</a></li>
            <li><a href="/study-sessions" class="<%= cp.indexOf('/study-sessions') === 0 ? 'active' : '' %>">Study Sessions</a></li>
          </ul>
        </details>
      </li>
      <% } %>

      <% if(enabledSlugs.indexOf('health') !== -1){ %>
      <li class="nav-group">
        <details <%= healthActive ? 'open' : '' %>>
          <summary class="<%= healthActive ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-heartbeat" aria-hidden="true"></i></span> Health &amp; Wellness <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i></summary>
          <ul class="nav-subgroup">
            <li><a href="/modules/health" class="<%= cp.indexOf('/modules/health') === 0 ? 'active' : '' %>">Overview</a></li>
            <li><a href="/sleep" class="<%= cp.indexOf('/sleep') === 0 ? 'active' : '' %>">Sleep</a></li>
            <li><a href="/water" class="<%= cp.indexOf('/water') === 0 ? 'active' : '' %>">Water Intake</a></li>
            <li><a href="/exercise" class="<%= cp.indexOf('/exercise') === 0 ? 'active' : '' %>">Exercise</a></li>
            <li><a href="/mood" class="<%= cp.indexOf('/mood') === 0 ? 'active' : '' %>">Mood</a></li>
            <li><a href="/medications" class="<%= cp.indexOf('/medications') === 0 ? 'active' : '' %>">Medications</a></li>
          </ul>
        </details>
      </li>
      <% } %>

      <% if(enabledSlugs.indexOf('habits') !== -1){ %>
      <li><a href="/habits" class="<%= cp.indexOf('/habits') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-fire" aria-hidden="true"></i></span> Habits</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('focus') !== -1){ %>
      <li><a href="/focus" class="<%= cp.indexOf('/focus') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-crosshairs" aria-hidden="true"></i></span> Focus Mode</a></li>
      <% } %>

      <% if(enabledSlugs.indexOf('screentime') !== -1){ %>
      <li class="nav-group">
        <details <%= digitalActive ? 'open' : '' %>>
          <summary class="<%= digitalActive ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-mobile-alt" aria-hidden="true"></i></span> Digital Wellbeing <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i></summary>
          <ul class="nav-subgroup">
            <li><a href="/modules/screentime" class="<%= cp.indexOf('/modules/screentime') === 0 ? 'active' : '' %>">Overview</a></li>
            <li><a href="/screen-time" class="<%= cp.indexOf('/screen-time') === 0 ? 'active' : '' %>">Screen Time</a></li>
            <li><a href="/social-media" class="<%= cp.indexOf('/social-media') === 0 ? 'active' : '' %>">Social Media</a></li>
          </ul>
        </details>
      </li>
      <% } %>

      <% if(enabledSlugs.indexOf('finance') !== -1){ %>
      <li class="nav-group">
        <details <%= financeActive ? 'open' : '' %>>
          <summary class="<%= financeActive ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-wallet" aria-hidden="true"></i></span> Finance Tracker <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i></summary>
          <ul class="nav-subgroup">
            <li><a href="/modules/finance" class="<%= cp.indexOf('/modules/finance') === 0 ? 'active' : '' %>">Overview</a></li>
            <li><a href="/expenses" class="<%= cp.indexOf('/expenses') === 0 ? 'active' : '' %>">Expenses</a></li>
            <li><a href="/savings-goals" class="<%= cp.indexOf('/savings-goals') === 0 ? 'active' : '' %>">Savings Goals</a></li>
          </ul>
        </details>
      </li>
      <% } %>

      <% if(enabledSlugs.indexOf('goals') !== -1){ %>
      <li><a href="/goals" class="<%= cp.indexOf('/goals') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-bullseye" aria-hidden="true"></i></span> Goals</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('journal') !== -1){ %>
      <li><a href="/journal" class="<%= cp.indexOf('/journal') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-pen" aria-hidden="true"></i></span> Journal</a></li>
      <% } %>
      <% if(enabledSlugs.indexOf('reports') !== -1){ %>
      <li><a href="/modules/reports" class="<%= cp.indexOf('/modules/reports') === 0 ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-chart-line" aria-hidden="true"></i></span> Reports</a></li>
      <% } %>
      <li><a href="/modules/settings" class="<%= (cp.indexOf('/modules/settings') === 0 || (cp.indexOf('/modules') === 0 && !studyActive && !healthActive && !digitalActive && !financeActive && cp.indexOf('/modules/reports') !== 0)) ? 'active' : '' %>"><span class="nav-icon"><i class="fas fa-cog" aria-hidden="true"></i></span> Settings</a></li>
    </nav>
    <div class="sidebar-foot">
      <button type="button" class="install-app-btn js-install-app" hidden>
        <i class="fas fa-arrow-down" aria-hidden="true"></i> Install App
      </button>
      <a href="/modules/settings" class="xp-chip" title="<%= levelInfo.xpIntoLevel %>/<%= levelInfo.xpForNextLevel %> XP to next level">
        <div class="xp-level">Lv <%= levelInfo.level %></div>
        <div class="xp-info">
          <div class="xp-title"><%= levelInfo.title %></div>
          <div class="xp-track"><div class="xp-fill" style="width:<%= levelInfo.progressPercent %>%"></div></div>
        </div>
      </a>
      <div class="user-chip">
        <% if(user.profile_picture){ %>
          <img src="<%= user.profile_picture %>" class="user-avatar" alt="" />
        <% } else { %>
          <div class="user-avatar" aria-hidden="true"><%= user.name.charAt(0).toUpperCase() %></div>
        <% } %>
        <span class="user-name"><%= user.name %></span>
      </div>
      <a href="/logout" style="text-decoration:none">
        <button class="btn-logout" id="logoutBtn"><i class="fas fa-sign-out-alt" aria-hidden="true"></i> Logout</button>
      </a>
    </div>
  </aside>

  <main class="main-content">
    <div class="topbar" role="navigation" aria-label="Notifications">
      <button type="button" class="topbar-menu-btn" id="topbarMenuBtn" aria-label="Open navigation">
        <i class="fas fa-bars" aria-hidden="true"></i>
      </button>
      <button type="button" class="topbar-search-btn" id="commandPaletteTrigger" title="Search (Ctrl+K)">
        <i class="fas fa-search" aria-hidden="true"></i> <span class="topbar-search-label">Search</span> <kbd>Ctrl K</kbd>
      </button>
      <div class="topbar-spacer"></div>
      <button type="button" class="install-app-btn install-app-btn-top js-install-app" hidden>
        <i class="fas fa-arrow-down" aria-hidden="true"></i> Install App
      </button>
      <% if(dueNotifications && dueNotifications.length){ %>
        <span class="notif-chip" id="notifChip" title="<%= dueNotifications.length %> due notification(s)">
          <i class="fas fa-bell" aria-hidden="true"></i> <%= dueNotifications.length %> due
