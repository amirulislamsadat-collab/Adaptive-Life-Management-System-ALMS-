<%- include('header', { currentPath: '/journal' }) %>
<div class="page page-center">
  <a href="/journal" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Journal</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= entry ? 'edit' : 'pen' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="journalForm">
      <div class="form-row">
        <div class="fg">
          <label for="jDate">Date <span class="required">*</span></label>
          <input id="jDate" type="date" name="entry_date" required value="<%= entry ? new Date(entry.entry_date).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="fg">
          <label>Mood (optional)</label>
          <div class="pill-picker">
            <input type="radio" id="jmSkip" name="mood_tag" value="" <%= !entry || !entry.mood_tag ? 'checked' : '' %>>
            <label class="pill-option" for="jmSkip">Skip</label>
            <input type="radio" id="jmGreat" name="mood_tag" value="great" <%= entry && entry.mood_tag==='great' ? 'checked' : '' %>>
            <label class="pill-option" for="jmGreat"><span class="pill-emoji">😄</span> Great</label>
            <input type="radio" id="jmGood" name="mood_tag" value="good" <%= entry && entry.mood_tag==='good' ? 'checked' : '' %>>
            <label class="pill-option" for="jmGood"><span class="pill-emoji">🙂</span> Good</label>
            <input type="radio" id="jmOkay" name="mood_tag" value="okay" <%= entry && entry.mood_tag==='okay' ? 'checked' : '' %>>
            <label class="pill-option" for="jmOkay"><span class="pill-emoji">😐</span> Okay</label>
            <input type="radio" id="jmLow" name="mood_tag" value="low" <%= entry && entry.mood_tag==='low' ? 'checked' : '' %>>
            <label class="pill-option" for="jmLow"><span class="pill-emoji">😕</span> Low</label>
            <input type="radio" id="jmBad" name="mood_tag" value="bad" <%= entry && entry.mood_tag==='bad' ? 'checked' : '' %>>
            <label class="pill-option" for="jmBad"><span class="pill-emoji">😞</span> Bad</label>
          </div>
        </div>
      </div>
      <div class="fg">
        <label for="jTitle">Title <span class="required">*</span></label>
        <input id="jTitle" type="text" name="title" required placeholder="Give today a headline..." value="<%= entry ? entry.title : '' %>">
      </div>
      <div class="fg">
        <label for="jContent">Entry</label>
        <textarea id="jContent" name="content" placeholder="Write about your day..." rows="8"><%= entry ? entry.content || '' : '' %></textarea>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/journal" id="cancelEntryBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveEntryBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Entry</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
