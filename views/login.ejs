<%- include('header') %>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-icon-wrap">
      <div class="auth-icon"><i class="fas fa-infinity"></i></div>
      <div class="auth-title" id="loginTitle">Welcome!</div>
      <div class="auth-sub" id="loginSub">New here? Sign in below or create an account to get started.</div>
    </div>
    <script>
      (function() {
        try {
          if (localStorage.getItem('alms_returning_user') === '1') {
            document.getElementById('loginTitle').textContent = 'Welcome Back';
            document.getElementById('loginSub').textContent = 'Sign in to your ALMS workspace';
          }
        } catch (e) {}
      })();
    </script>
    <form method="POST" action="/login">
      <div class="form-grp">
        <label class="form-lbl">Email Address</label>
        <input class="form-inp" type="email" name="email" placeholder="you@example.com" required>
      </div>
      <div class="form-grp">
        <label class="form-lbl">Password</label>
        <input class="form-inp" type="password" name="password" placeholder="Your password" required>
      </div>
      <button type="submit" class="btn-auth">Sign In</button>
    </form>
    <% if (googleAuthConfigured) { %>
      <div class="auth-divider"><span>or</span></div>
      <a href="/auth/google" class="btn-google"><i class="fab fa-google" aria-hidden="true"></i> Continue with Google</a>
    <% } %>
    <div class="auth-foot">Don't have an account? <a href="/register">Create one</a></div>
  </div>
</div>
<%- include('footer') %>
