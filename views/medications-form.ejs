<%- include('header', { currentPath: '/medications' }) %>
<%
  const selectedDays = medication && medication.days_of_week ? medication.days_of_week.split(',') : [];
%>
<div class="page page-center">
  <a href="/medications" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Medications</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= medication ? 'edit' : 'pills' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="medicationForm">
      <div class="fg">
        <label for="medName">Medication Name <span class="required">*</span></label>
        <input id="medName" type="text" name="medication_name" required placeholder="e.g. Vitamin D, Amoxicillin" value="<%= medication ? medication.medication_name : '' %>">
      </div>
      <div class="form-row">
        <div class="fg">
          <label for="medDosage">Dosage</label>
          <input id="medDosage" type="text" name="dosage" placeholder="e.g. 1 tablet, 500mg" value="<%= medication ? medication.dosage || '' : '' %>">
        </div>
        <div class="fg">
          <label for="medTime">Reminder Time <span class="required">*</span></label>
          <input id="medTime" type="time" name="time_of_day" required value="<%= medication ? medication.time_of_day.slice(0,5) : '09:00' %>">
        </div>
      </div>
      <div class="fg">
        <label>Frequency <span class="required">*</span></label>
        <div class="pill-picker">
          <input type="radio" id="medFreqDaily" name="frequency" value="daily" <%= !medication || medication.frequency==='daily' ? 'checked' : '' %>>
          <label class="pill-option" for="medFreqDaily"><span class="pill-emoji">📅</span> Daily</label>
          <input type="radio" id="medFreqWeekdays" name="frequency" value="weekdays" <%= medication && medication.frequency==='weekdays' ? 'checked' : '' %>>
          <label class="pill-option" for="medFreqWeekdays"><span class="pill-emoji">💼</span> Weekdays</label>
          <input type="radio" id="medFreqCustom" name="frequency" value="custom" <%= medication && medication.frequency==='custom' ? 'checked' : '' %>>
          <label class="pill-option" for="medFreqCustom"><span class="pill-emoji">🎛️</span> Custom</label>
        </div>
      </div>
      <div class="fg" id="daysWrap" style="display:none;">
        <label>Custom Weekdays</label>
        <div class="days-grid">
          <% ['MO','TU','WE','TH','FR','SA','SU'].forEach(day => { %>
            <label class="day-checkbox">
              <input type="checkbox" name="days_of_week" value="<%= day %>" <%= selectedDays.includes(day) ? 'checked' : '' %>>
              <span class="day-label"><%= day %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <div class="fg">
        <label for="medNotes">Notes</label>
        <textarea id="medNotes" name="notes" placeholder="Instructions, reason, etc..." rows="3"><%= medication ? medication.notes || '' : '' %></textarea>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/medications" id="cancelMedicationBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveMedicationBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Reminder</button>
      </div>
    </form>
  </div>
</div>
<script>
(function(){
  const freqInputs = document.querySelectorAll('input[name="frequency"]');
  const wrap = document.getElementById('daysWrap');
  function toggleDays(){
    const checked = document.querySelector('input[name="frequency"]:checked');
    wrap.style.display = checked && checked.value === 'custom' ? 'block' : 'none';
  }
  freqInputs.forEach(function(el){ el.addEventListener('change', toggleDays); });
  toggleDays();
})();
</script>
<%- include('footer') %>
