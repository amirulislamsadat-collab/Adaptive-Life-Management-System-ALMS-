<%- include('header', { currentPath: '/profile' }) %>
<div class="page">
  <div class="top-header">
    <h1 class="page-title"><i class="fas fa-user" aria-hidden="true"></i> Your Profile</h1>
    <p class="page-desc">Your avatar, stats, and a couple of things we use to personalize your targets.</p>
  </div>

  <div class="profile-hero">
    <div class="profile-hero-avatar">
      <%- include('partials/avatar', { gender: user.avatar_gender, skin: user.avatar_skin, hair: user.avatar_hair, shirt: user.avatar_shirt, size: 100 }) %>
    </div>
    <div class="profile-hero-info">
      <form method="POST" action="/profile/name" class="profile-name-form">
        <input type="text" name="name" value="<%= user.name %>" required>
        <button type="submit" class="btn secondary btn-sm">Save</button>
      </form>
      <div class="profile-hero-meta">
        <span><i class="fas fa-envelope" aria-hidden="true"></i> <%= user.email %></span>
        <span><i class="fas fa-user-tag" aria-hidden="true"></i> <%= user.role %></span>
        <span><i class="fas fa-calendar" aria-hidden="true"></i> Since <%= new Date(fullUser.created_at).toLocaleDateString('en-US',{month:'short',year:'numeric'}) %></span>
      </div>
    </div>
  </div>

  <div class="profile-stats-row">
    <div class="profile-stat-card">
      <div class="score-ring" style="--score: <%= levelInfo.progressPercent %>; --score-color: var(--primary); width:80px;height:80px;">
        <div class="score-ring-inner" style="width:62px;height:62px;">
          <div class="score-ring-value" style="font-size:18px;">Lv<%= levelInfo.level %></div>
        </div>
      </div>
      <div>
        <div class="profile-stat-title"><%= levelInfo.title %></div>
        <div class="profile-stat-sub"><%= levelInfo.xpIntoLevel %> / <%= levelInfo.xpForNextLevel %> XP &middot; <%= levelInfo.xp %> total</div>
      </div>
    </div>
    <div class="profile-stat-card">
      <div class="profile-stat-icon streak"><i class="fas fa-fire" aria-hidden="true"></i></div>
      <div>
        <div class="profile-stat-title"><%= fullUser.current_streak || 0 %> day streak</div>
        <div class="profile-stat-sub">Longest: <%= fullUser.longest_streak || 0 %> days</div>
      </div>
    </div>
  </div>

  <div class="section-header">
    <div class="section-title"><i class="fas fa-palette" aria-hidden="true"></i> Customize Avatar</div>
  </div>
  <div class="card" style="margin-bottom:40px;">
    <form method="POST" action="/profile/avatar">
      <div class="avatar-builder" id="avatarBuilder" style="--av-skin:<%= user.avatar_skin %>;--av-hair:<%= user.avatar_hair %>;--av-shirt:<%= user.avatar_shirt %>;margin-bottom:24px;">
        <div class="avatar-preview">
          <div id="avPreviewMale" <%= user.avatar_gender==='female' ? 'hidden' : '' %>><%- include('partials/avatar', { gender: 'male', size: 120 }) %></div>
          <div id="avPreviewFemale" <%= user.avatar_gender==='female' ? '' : 'hidden' %>><%- include('partials/avatar', { gender: 'female', size: 120 }) %></div>
        </div>

        <div class="avatar-opt-group">
          <label>I am...</label>
          <div class="avatar-gender-toggle">
            <button type="button" class="avatar-gender-btn <%= user.avatar_gender!=='female'?'active':'' %>" data-gender="male" id="genderMaleBtn">🙋‍♂️ A guy</button>
            <button type="button" class="avatar-gender-btn <%= user.avatar_gender==='female'?'active':'' %>" data-gender="female" id="genderFemaleBtn">🙋‍♀️ A girl</button>
          </div>
          <input type="hidden" name="gender" id="genderInput" value="<%= user.avatar_gender || 'male' %>">
        </div>

        <div class="avatar-opt-group">
          <label>Skin tone</label>
          <div class="swatch-row" id="skinSwatches">
            <% ['#FDE0C4','#F0B594','#C88A5E','#8D5A3C','#5C3A24'].forEach(function(c){ %>
              <button type="button" class="swatch <%= user.avatar_skin===c?'active':'' %>" data-val="<%= c %>" style="background:<%= c %>" aria-label="Skin tone"></button>
            <% }) %>
          </div>
          <input type="hidden" name="skin" id="skinInput" value="<%= user.avatar_skin %>">
        </div>

        <div class="avatar-opt-group">
          <label>Hair color</label>
          <div class="swatch-row" id="hairSwatches">
            <% ['#0F0A08','#3B2314','#8B5A2B','#C99A3D','#B0B0B0'].forEach(function(c){ %>
              <button type="button" class="swatch <%= user.avatar_hair===c?'active':'' %>" data-val="<%= c %>" style="background:<%= c %>" aria-label="Hair color"></button>
            <% }) %>
          </div>
          <input type="hidden" name="hair" id="hairInput" value="<%= user.avatar_hair %>">
        </div>

        <div class="avatar-opt-group">
          <label>Shirt color</label>
          <div class="swatch-row" id="shirtSwatches">
            <% ['#5B8DEF','#FF5A5F','#10B981','#8B5CF6','#64748B'].forEach(function(c){ %>
              <button type="button" class="swatch <%= user.avatar_shirt===c?'active':'' %>" data-val="<%= c %>" style="background:<%= c %>" aria-label="Shirt color"></button>
            <% }) %>
          </div>
          <input type="hidden" name="shirt" id="shirtInput" value="<%= user.avatar_shirt %>">
        </div>
      </div>

      <div class="form-row">
        <div class="fg">
          <label for="ageInput">Age: <span id="ageVal"><%= user.age || 'Not set' %></span></label>
          <input type="range" id="ageInput" name="age" min="13" max="90" value="<%= user.age || 25 %>" class="range-slider"
            oninput="document.getElementById('ageVal').textContent=this.value; document.getElementById('ageTouched').value='1';">
          <input type="hidden" name="age_touched" id="ageTouched" value="<%= user.age ? '1' : '0' %>">
        </div>
        <div class="fg">
          <label for="weightInput">Weight: <span id="weightVal"><%= user.weight_kg ? user.weight_kg + ' kg' : 'Not set' %></span></label>
          <input type="range" id="weightInput" name="weight_kg" min="30" max="150" value="<%= user.weight_kg || 65 %>" class="range-slider"
            oninput="document.getElementById('weightVal').textContent=this.value+' kg'; document.getElementById('weightTouched').value='1';">
          <input type="hidden" name="weight_touched" id="weightTouched" value="<%= user.weight_kg ? '1' : '0' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="fg">
          <label for="expSelect">Experience level</label>
          <select id="expSelect" name="experience_level">
            <option value="beginner" <%= user.experience_level==='beginner'?'selected':'' %>>🌱 Just starting out</option>
            <option value="intermediate" <%= user.experience_level==='intermediate'?'selected':'' %>>🌿 Somewhere in between</option>
            <option value="experienced" <%= user.experience_level==='experienced'?'selected':'' %>>🌳 Pretty on top of it</option>
          </select>
        </div>
        <div class="fg">
          <label for="activitySelect">Activity level</label>
          <select id="activitySelect" name="activity_level">
            <option value="sedentary" <%= user.activity_level==='sedentary'?'selected':'' %>>Mostly sedentary</option>
            <option value="lightly_active" <%= user.activity_level==='lightly_active'?'selected':'' %>>Lightly active</option>
            <option value="active" <%= user.activity_level==='active'?'selected':'' %>>Active</option>
            <option value="very_active" <%= user.activity_level==='very_active'?'selected':'' %>>Very active</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn primary">Save changes</button>
    </form>
  </div>
</div>
<script>
(function() {
  var builder = document.getElementById('avatarBuilder');
  var maleBtn = document.getElementById('genderMaleBtn');
  var femaleBtn = document.getElementById('genderFemaleBtn');
  var maleAv = document.getElementById('avPreviewMale');
  var femaleAv = document.getElementById('avPreviewFemale');
  var genderInput = document.getElementById('genderInput');

  function setGender(g) {
    genderInput.value = g;
    maleBtn.classList.toggle('active', g === 'male');
    femaleBtn.classList.toggle('active', g === 'female');
    maleAv.hidden = g !== 'male';
    femaleAv.hidden = g !== 'female';
  }
  maleBtn.addEventListener('click', function() { setGender('male'); });
  femaleBtn.addEventListener('click', function() { setGender('female'); });

  function wireSwatches(containerId, inputId, cssVar) {
    var container = document.getElementById(containerId);
    var input = document.getElementById(inputId);
    container.querySelectorAll('.swatch').forEach(function(sw) {
      sw.addEventListener('click', function() {
        container.querySelectorAll('.swatch').forEach(function(s) { s.classList.remove('active'); });
        sw.classList.add('active');
        var val = sw.dataset.val;
        input.value = val;
        builder.style.setProperty(cssVar, val);
      });
    });
  }
  wireSwatches('skinSwatches', 'skinInput', '--av-skin');
  wireSwatches('hairSwatches', 'hairInput', '--av-hair');
  wireSwatches('shirtSwatches', 'shirtInput', '--av-shirt');
})();
</script>
<%- include('footer') %>
