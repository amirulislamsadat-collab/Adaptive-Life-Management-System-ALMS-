<%- include('header', { currentPath: '/screen-time' }) %>
<%
  const selectedCategory = log ? log.category : 'non_productive';
%>
<div class="page page-center">
  <a href="/screen-time" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Screen Time</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= log ? 'edit' : 'hourglass-half' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="screenTimeForm">
      <div class="form-row">
        <div class="fg">
          <label for="stDate">Date <span class="required">*</span></label>
          <input id="stDate" type="date" name="log_date" required value="<%= log ? new Date(log.log_date).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="fg">
          <label for="stActivity">Activity <span class="required">*</span></label>
          <input id="stActivity" type="text" name="activity_name" required placeholder="e.g. Coding, Netflix, Reading" value="<%= log ? log.activity_name : '' %>">
        </div>
      </div>
      <div class="fg">
        <label for="stMinutes">Duration: <span class="live-val" id="stMinutesVal"><%= log ? log.minutes : 30 %></span> min <span class="required">*</span></label>
        <div class="quick-chip-row">
          <button type="button" class="quick-chip" data-target="stMinutes" data-val="15">15 min</button>
          <button type="button" class="quick-chip" data-target="stMinutes" data-val="30">30 min</button>
          <button type="button" class="quick-chip" data-target="stMinutes" data-val="60">1 hr</button>
          <button type="button" class="quick-chip" data-target="stMinutes" data-val="120">2 hrs</button>
        </div>
        <input id="stMinutes" type="range" name="minutes" min="5" max="480" step="5" required value="<%= log ? log.minutes : 30 %>" class="range-slider" data-live-label="stMinutesVal">
        <div class="slider-minmax"><span>5 min</span><span>8 hrs</span></div>
      </div>
      <div class="fg">
        <label>Category</label>
        <div class="category-toggle">
          <input type="radio" id="catProductive" name="category" value="productive" <%= selectedCategory === 'productive' ? 'checked' : '' %>>
          <label for="catProductive" class="productive-label"><i class="fas fa-check-circle" aria-hidden="true"></i> Productive</label>
          <input type="radio" id="catNonProductive" name="category" value="non_productive" <%= selectedCategory !== 'productive' ? 'checked' : '' %>>
          <label for="catNonProductive" class="non-productive-label"><i class="fas fa-couch" aria-hidden="true"></i> Non-Productive</label>
        </div>
      </div>
      <div class="fg">
        <label for="stNotes">Notes</label>
        <textarea id="stNotes" name="notes" placeholder="Any details worth remembering..." rows="3"><%= log ? log.notes || '' : '' %></textarea>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/screen-time" id="cancelScreenTimeBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveScreenTimeBtn"><i class="fas fa-save" aria-hidden="true"></i> Save</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
