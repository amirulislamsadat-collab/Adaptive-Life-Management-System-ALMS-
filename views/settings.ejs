<%- include('header', { currentPath: '/modules/settings' }) %>
<div class="page">
  <div class="top-header">
    <h1 class="page-title">
      <i class="fas fa-cog" aria-hidden="true"></i> Settings
    </h1>
    <p class="page-desc">Manage your modules, appearance, and account.</p>
  </div>

  <div class="section-header">
    <div class="section-title"><i class="fas fa-puzzle-piece" aria-hidden="true"></i> Modules</div>
  </div>

  <div class="info-box">
    <div class="info-box-head">
      <i class="fas fa-shield-alt" aria-hidden="true"></i> Safe Data Preservation
    </div>
    <p>Don't worry about losing your work! Disabling a module only hides it from your workspace. All your underlying data is safely preserved in the database and will be exactly as you left it when you re-enable the module.</p>
  </div>

  <div class="mods-grid" style="margin-bottom:40px;">
    <% modules.forEach(function(mod){ %>
    <div class="mc <%= mod.is_enabled ? 'on' : '' %>">
      <div class="mc-top">
        <div class="mc-icon">
          <%- mod.slug==='tasks'?'<i class="fas fa-tasks"></i>':mod.slug==='study'?'<i class="fas fa-book-open"></i>':mod.slug==='finance'?'<i class="fas fa-money-bill-wave"></i>':mod.slug==='health'?'<i class="fas fa-heart"></i>':mod.slug==='notes'?'<i class="fas fa-sticky-note"></i>':mod.slug==='calendar'?'<i class="fas fa-calendar-alt"></i>':mod.slug==='reminders'?'<i class="fas fa-clock"></i>':mod.slug==='alarms'?'<i class="fas fa-bell"></i>':mod.slug==='subjects'?'<i class="fas fa-book"></i>':mod.slug==='habits'?'<i class="fas fa-fire"></i>':mod.slug==='screentime'?'<i class="fas fa-mobile-alt"></i>':mod.slug==='journal'?'<i class="fas fa-pen"></i>':mod.slug==='goals'?'<i class="fas fa-bullseye"></i>':mod.slug==='reports'?'<i class="fas fa-chart-line"></i>':mod.slug==='focus'?'<i class="fas fa-crosshairs"></i>':'<i class="fas fa-pencil-alt"></i>' %>
        </div>
        <div class="mc-info">
          <h4><%= mod.name %></h4>
          <p><%= mod.description %></p>
        </div>
      </div>
      <div class="mc-foot">
        <% if(mod.is_enabled){ %>
          <div class="status-on">
            <div class="sdot green"><i class="fas fa-check" aria-hidden="true" style="font-size:10px;color:white;"></i></div>
            Enabled
          </div>
          <form method="POST" action="/modules/settings/toggle/<%= mod.id %>">
            <button type="submit" class="btn-disable">Disable</button>
          </form>
        <% } else { %>
          <div class="status-off">
            <div class="sdot gray"><i class="fas fa-times" aria-hidden="true" style="font-size:10px;color:white;"></i></div>
            Disabled
          </div>
          <form method="POST" action="/modules/settings/toggle/<%= mod.id %>">
            <button type="submit" class="btn-enable">Enable</button>
          </form>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="section-header">
    <div class="section-title"><i class="fas fa-palette" aria-hidden="true"></i> Appearance</div>
  </div>
  <div class="card" style="margin-bottom:40px;">
    <div class="fg" style="margin-bottom:0;">
      <label>Theme</label>
      <div class="category-toggle" id="themeToggle">
        <input type="radio" id="themeLight" name="theme" value="light">
        <label for="themeLight" class="productive-label"><i class="fas fa-sun" aria-hidden="true"></i> Light</label>
        <input type="radio" id="themeDark" name="theme" value="dark">
        <label for="themeDark" class="non-productive-label"><i class="fas fa-moon" aria-hidden="true"></i> Dark</label>
      </div>
    </div>
  </div>

  <% if(pushConfigured){ %>
  <div class="section-header">
    <div class="section-title"><i class="fas fa-bell" aria-hidden="true"></i> Notifications</div>
  </div>
  <div class="card" style="margin-bottom:40px;">
    <div class="fg" style="margin-bottom:0;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div>
        <label style="margin-bottom:4px;">Push notifications</label>
        <p style="font-size:13px;color:var(--text-muted);margin:0;">Get a real notification for due reminders and alarms — even when ALMS isn't open in a tab.</p>
      </div>
      <button type="button" class="btn secondary btn-sm" id="pushToggleBtn">Loading...</button>
    </div>
  </div>
  <script>
  (function() {
    var btn = document.getElementById('pushToggleBtn');
    var VAPID_PUBLIC_KEY = <%- JSON.stringify(pushPublicKey) %>;

    function urlBase64ToUint8Array(base64String) {
      var padding = '='.repeat((4 - base64String.length % 4) % 4);
      var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      var rawData = atob(base64);
      var outputArray = new Uint8Array(rawData.length);
      for (var i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i);
      return outputArray;
    }

    function setBtn(subscribed) {
      btn.textContent = subscribed ? 'Disable' : 'Enable';
      btn.dataset.subscribed = subscribed ? '1' : '0';
    }

    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      btn.textContent = 'Not supported in this browser';
      btn.disabled = true;
      return;
    }

    navigator.serviceWorker.ready.then(function(reg) {
      reg.pushManager.getSubscription().then(function(sub) { setBtn(!!sub); });

      btn.addEventListener('click', function() {
        btn.disabled = true;
        if (btn.dataset.subscribed === '1') {
          reg.pushManager.getSubscription().then(function(sub) {
            if (!sub) { btn.disabled = false; return; }
            var endpoint = sub.endpoint;
            sub.unsubscribe().then(function() {
              fetch('/push/unsubscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ endpoint: endpoint }) })
                .finally(function() { setBtn(false); btn.disabled = false; });
            });
          });
        } else {
          Notification.requestPermission().then(function(perm) {
            if (perm !== 'granted') { btn.disabled = false; return; }
            reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY) })
              .then(function(sub) {
                return fetch('/push/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ subscription: sub }) });
              })
              .then(function() { setBtn(true); btn.disabled = false; })
              .catch(function() { btn.disabled = false; });
          });
        }
      });
    });
  })();
  </script>
  <% } %>

  <div class="section-header">
    <div class="section-title"><i class="fas fa-trophy" aria-hidden="true"></i> Progress</div>
  </div>
  <div class="card" style="margin-bottom:40px;">
    <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;">
      <div class="score-ring" style="--score: <%= levelInfo.progressPercent %>; --score-color: var(--primary); width:120px;height:120px;">
        <div class="score-ring-inner" style="width:96px;height:96px;">
          <div class="score-ring-value" style="font-size:28px;">Lv <%= levelInfo.level %></div>
        </div>
      </div>
      <div style="flex:1;min-width:200px;">
        <div style="font-weight:700;font-size:16px;margin-bottom:6px;"><%= levelInfo.title %></div>
        <div class="progress-track"><div class="progress-fill" style="width:<%= levelInfo.progressPercent %>%"></div></div>
        <div style="font-size:13px;color:var(--text-muted);margin-top:6px;"><%= levelInfo.xpIntoLevel %> / <%= levelInfo.xpForNextLevel %> XP to Level <%= levelInfo.level + 1 %> &middot; <%= levelInfo.xp %> XP total</div>
      </div>
    </div>
  </div>

  <div class="section-header">
    <div class="section-title"><i class="fas fa-user-circle" aria-hidden="true"></i> Account</div>
  </div>
  <div class="card">
    <div style="display:flex;align-items:center;gap:20px;margin-bottom:28px;flex-wrap:wrap;">
      <% if(user.profile_picture){ %>
        <img src="<%= user.profile_picture %>" alt="" style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid var(--border-color);">
      <% } else { %>
        <div class="user-avatar" style="width:80px;height:80px;font-size:32px;"><%= user.name.charAt(0).toUpperCase() %></div>
      <% } %>
      <div>
        <form method="POST" action="/account/photo" enctype="multipart/form-data" id="photoForm" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
          <input type="file" accept="image/*" id="photoInput" style="display:none;">
          <input type="hidden" name="photo_data" id="photoData">
          <button type="button" class="btn secondary btn-sm" id="choosePhotoBtn"><i class="fas fa-camera" aria-hidden="true"></i> Change Photo</button>
        </form>
        <% if(user.profile_picture){ %>
        <form method="POST" action="/account/photo/remove" style="display:inline-block;margin-top:8px;">
          <button type="submit" class="btn danger btn-sm"><i class="fas fa-trash-alt" aria-hidden="true"></i> Remove</button>
        </form>
        <% } %>
      </div>
    </div>

    <form method="POST" action="/account/name" class="fg" style="display:flex;gap:10px;align-items:flex-end;">
      <div style="flex:1;">
        <label for="acctName">Name</label>
        <input id="acctName" type="text" name="name" value="<%= user.name %>" required>
      </div>
      <button type="submit" class="btn secondary btn-sm">Save</button>
    </form>
    <div class="fg">
      <label>Email</label>
      <div><%= user.email %></div>
    </div>
    <div class="fg" style="margin-bottom:0;">
      <label>Role</label>
      <div><%= user.role %></div>
    </div>
  </div>
</div>
<script>
(function() {
  var chooseBtn = document.getElementById('choosePhotoBtn');
  var fileInput = document.getElementById('photoInput');
  var dataField = document.getElementById('photoData');
  var form = document.getElementById('photoForm');
  if (!chooseBtn) return;

  chooseBtn.addEventListener('click', function() { fileInput.click(); });

  fileInput.addEventListener('change', function() {
    var file = fileInput.files[0];
    if (!file) return;
    var img = new Image();
    var reader = new FileReader();
    reader.onload = function(e) {
      img.onload = function() {
        // Downscale to at most 320px so the base64 payload stays small.
        var maxDim = 320;
        var scale = Math.min(1, maxDim / Math.max(img.width, img.height));
        var canvas = document.createElement('canvas');
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        var ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        dataField.value = canvas.toDataURL('image/jpeg', 0.85);
        form.removeAttribute('enctype');
        form.submit();
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });
})();
</script>
<script>
(function() {
  var light = document.getElementById('themeLight');
  var dark = document.getElementById('themeDark');
  var current = document.documentElement.getAttribute('data-theme') || 'light';
  (current === 'dark' ? dark : light).checked = true;

  function setTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    try { localStorage.setItem('alms_theme', theme); } catch (e) {}
  }
  light.addEventListener('change', function() { if (light.checked) setTheme('light'); });
  dark.addEventListener('change', function() { if (dark.checked) setTheme('dark'); });
})();
</script>
<%- include('footer') %>
