<%- include('header') %>
<div class="setup-page">
  <!-- Stepper -->
  <% const stepOrder = ['role','modules','profile']; const stepIdx = stepOrder.indexOf(step); %>
  <div class="stepper">
    <div class="step-item">
      <div class="step-circle <%= stepIdx===0 ? 'active' : 'done' %>">
        <%- stepIdx===0 ? '1' : '<i class="fas fa-check"></i>' %>
      </div>
      <span class="step-label <%= stepIdx===0 ? 'active' : 'done' %>">Role</span>
    </div>
    <div class="step-connector <%= stepIdx>=1 ? 'done' : '' %>"></div>
    <div class="step-item">
      <div class="step-circle <%= stepIdx===1 ? 'active' : (stepIdx>1 ? 'done' : 'inactive') %>">
        <%- stepIdx>1 ? '<i class="fas fa-check"></i>' : '2' %>
      </div>
      <span class="step-label <%= stepIdx===1 ? 'active' : (stepIdx>1 ? 'done' : '') %>">Modules</span>
    </div>
    <div class="step-connector <%= stepIdx>=2 ? 'done' : '' %>"></div>
    <div class="step-item">
      <div class="step-circle <%= stepIdx===2 ? 'active' : 'inactive' %>">3</div>
      <span class="step-label <%= stepIdx===2 ? 'active' : '' %>">You</span>
    </div>
  </div>

  <% if(step === 'role') { %>
  <h1 class="setup-title"><i class="fas fa-user"></i> Who Are You?</h1>
  <p class="setup-sub">Select your primary role so we can recommend the best modules for you</p>

  <form method="POST" action="/setup/role" id="roleForm">
    <input type="hidden" name="role_id" id="roleInput" value="">
    <div class="role-grid">
      <% roles.forEach(function(r){ %>
      <div class="role-card" onclick="pickRole(<%= r.id %>,this)" id="rc_<%= r.id %>">
        <div class="check"><i class="fas fa-check"></i></div>
        <div class="role-icon <%= r.name.toLowerCase() %>">
          <%- r.name==='Student' ? '<i class="fas fa-graduation-cap"></i>' : r.name==='Professional' ? '<i class="fas fa-briefcase"></i>' : '<i class="fas fa-rocket"></i>' %>
        </div>
        <div class="role-name"><%= r.name %></div>
        <div class="role-desc"><%= r.description %></div>
      </div>
      <% }) %>
    </div>
    <button type="submit" class="btn-continue" id="contBtn" disabled>Continue →</button>
  </form>
  <script>
    function pickRole(id,el){
      document.querySelectorAll('.role-card').forEach(c=>c.classList.remove('selected'));
      el.classList.add('selected');
      document.getElementById('roleInput').value=id;
      document.getElementById('contBtn').disabled=false;
    }
  </script>

  <% } else if(step === 'modules') { %>
  <div class="role-badge-top">
    <span class="role-badge"><i class="fas fa-user"></i> <%= user.role %></span>
  </div>
  <h1 class="setup-title"><i class="fas fa-puzzle-piece"></i> Customize Your Workspace</h1>
  <p class="setup-sub">We've recommended modules based on your role. Toggle them to fit your needs.</p>
  <p class="selected-count">Selected: <span id="selCount"><%= recommended.length %></span> modules</p>

  <form method="POST" action="/setup/modules" id="modForm">
    <div class="mod-grid">
      <% modules.forEach(function(mod){ %>
      <% const isRec = recommended.includes(mod.id); %>
      <div class="mod-toggle-card <%= isRec ? 'on' : '' %>" id="mcard_<%= mod.id %>">
        <% if(isRec){ %><div class="rec-badge">Recommended</div><% } %>
        <div class="mod-top">
          <div class="mod-icon-sm">
            <%- mod.slug==='tasks'?'<i class="fas fa-tasks"></i>':mod.slug==='study'?'<i class="fas fa-book-open"></i>':mod.slug==='finance'?'<i class="fas fa-money-bill-wave"></i>':mod.slug==='health'?'<i class="fas fa-heart"></i>':mod.slug==='notes'?'<i class="fas fa-sticky-note"></i>':mod.slug==='calendar'?'<i class="fas fa-calendar-alt"></i>':mod.slug==='reminders'?'<i class="fas fa-clock"></i>':mod.slug==='alarms'?'<i class="fas fa-bell"></i>':mod.slug==='subjects'?'<i class="fas fa-book"></i>':mod.slug==='habits'?'<i class="fas fa-fire"></i>':mod.slug==='screentime'?'<i class="fas fa-mobile-alt"></i>':mod.slug==='journal'?'<i class="fas fa-pen"></i>':mod.slug==='goals'?'<i class="fas fa-bullseye"></i>':mod.slug==='reports'?'<i class="fas fa-chart-line"></i>':'<i class="fas fa-pencil-alt"></i>' %>
          </div>
          <div class="mod-info-sm">
            <h4><%= mod.name %></h4>
            <p><%= mod.description %></p>
          </div>
        </div>
        <div class="toggle-row">
          <label class="toggle-switch">
            <input type="checkbox" name="modules" value="<%= mod.id %>" <%= isRec ? 'checked' : '' %> onchange="updateCount()">
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="setup-actions">
      <a href="/setup" class="btn-back-setup">← Back</a>
      <button type="submit" class="btn-launch"><i class="fas fa-arrow-right"></i> Continue</button>
    </div>
  </form>
  <script>
    function updateCount(){
      const c=document.querySelectorAll('input[name="modules"]:checked').length;
      document.getElementById('selCount').textContent=c;
      document.querySelectorAll('.mod-toggle-card').forEach(card=>{
        const cb=card.querySelector('input[type="checkbox"]');
        if(cb.checked) card.classList.add('on'); else card.classList.remove('on');
      });
    }
  </script>

  <% } else if(step === 'profile') { %>
  <div class="setup-mascot">🦉</div>
  <h1 class="setup-title">One last thing, <%= user.name.split(' ')[0] %>!</h1>
  <p class="setup-sub">Add a profile picture so it's really you in there — totally optional, skip it if you're not feeling it right now.</p>

  <div class="profile-step-card">
    <div class="profile-step-photo">
      <img id="setupPhotoPreview" src="<%= user.profile_picture || '' %>" alt="" style="<%= user.profile_picture ? '' : 'display:none;' %>">
      <div id="setupPhotoPlaceholder" class="user-avatar" style="width:100%;height:100%;font-size:36px;<%= user.profile_picture ? 'display:none;' : '' %>"><%= user.name.charAt(0).toUpperCase() %></div>
    </div>
    <input type="file" accept="image/*" id="setupPhotoInput" style="display:none;">
    <button type="button" class="btn secondary btn-sm" id="setupChoosePhotoBtn"><i class="fas fa-camera" aria-hidden="true"></i> Choose a photo</button>
  </div>

  <form method="POST" action="/setup/profile" id="profileForm">
    <input type="hidden" name="photo_data" id="setupPhotoData">
    <div class="setup-actions">
      <button type="submit" class="btn-back-setup" id="skipProfileBtn">Skip for now</button>
      <button type="submit" class="btn-launch"><i class="fas fa-rocket"></i> Launch Workspace</button>
    </div>
  </form>
  <script>
  (function() {
    var chooseBtn = document.getElementById('setupChoosePhotoBtn');
    var fileInput = document.getElementById('setupPhotoInput');
    var dataField = document.getElementById('setupPhotoData');
    var preview = document.getElementById('setupPhotoPreview');
    var placeholder = document.getElementById('setupPhotoPlaceholder');

    chooseBtn.addEventListener('click', function() { fileInput.click(); });

    fileInput.addEventListener('change', function() {
      var file = fileInput.files[0];
      if (!file) return;
      var img = new Image();
      var reader = new FileReader();
      reader.onload = function(e) {
        img.onload = function() {
          var maxDim = 320;
          var scale = Math.min(1, maxDim / Math.max(img.width, img.height));
          var canvas = document.createElement('canvas');
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          var ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          var dataUrl = canvas.toDataURL('image/jpeg', 0.85);
          dataField.value = dataUrl;
          preview.src = dataUrl;
          preview.style.display = 'block';
          placeholder.style.display = 'none';
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    });
  })();
  </script>
  <% } %>
</div>
<%- include('footer') %>