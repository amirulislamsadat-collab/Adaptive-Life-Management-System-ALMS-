<%- include('header') %>
<div class="setup-page">
  <!-- Stepper -->
  <% const stepOrder = ['role','you','modules']; const stepIdx = stepOrder.indexOf(step); %>
  <div class="stepper">
    <div class="step-item">
      <div class="step-circle <%= stepIdx===0 ? 'active' : 'done' %>">
        <%- stepIdx===0 ? '1' : '<i class="fas fa-check"></i>' %>
      </div>
      <span class="step-label <%= stepIdx===0 ? 'active' : 'done' %>">Role</span>
    </div>
    <div class="step-connector <%= stepIdx>=1 ? 'done' : '' %>"></div>
    <div class="step-item">
      <div class="step-circle <%= stepIdx===1 ? 'active' : (stepIdx>1 ? 'done' : 'inactive') %>">
        <%- stepIdx>1 ? '<i class="fas fa-check"></i>' : '2' %>
      </div>
      <span class="step-label <%= stepIdx===1 ? 'active' : (stepIdx>1 ? 'done' : '') %>">You</span>
    </div>
    <div class="step-connector <%= stepIdx>=2 ? 'done' : '' %>"></div>
    <div class="step-item">
      <div class="step-circle <%= stepIdx===2 ? 'active' : 'inactive' %>">3</div>
      <span class="step-label <%= stepIdx===2 ? 'active' : '' %>">Modules</span>
    </div>
  </div>

  <% if(step === 'role') { %>
  <h1 class="setup-title"><i class="fas fa-user"></i> Who Are You?</h1>
  <p class="setup-sub">Select your primary role so we can recommend the best modules for you</p>

  <form method="POST" action="/setup/role" id="roleForm">
    <input type="hidden" name="role_id" id="roleInput" value="">
    <div class="role-grid">
      <% roles.forEach(function(r){ %>
      <div class="role-card" onclick="pickRole(<%= r.id %>,this)" id="rc_<%= r.id %>">
        <div class="check"><i class="fas fa-check"></i></div>
        <div class="role-icon <%= r.name.toLowerCase() %>">
          <%- r.name==='Student' ? '<i class="fas fa-graduation-cap"></i>' : r.name==='Professional' ? '<i class="fas fa-briefcase"></i>' : '<i class="fas fa-rocket"></i>' %>
        </div>
        <div class="role-name"><%= r.name %></div>
        <div class="role-desc"><%= r.description %></div>
      </div>
      <% }) %>
    </div>
    <button type="submit" class="btn-continue" id="contBtn" disabled>Continue →</button>
  </form>
  <script>
    function pickRole(id,el){
      document.querySelectorAll('.role-card').forEach(c=>c.classList.remove('selected'));
      el.classList.add('selected');
      document.getElementById('roleInput').value=id;
      document.getElementById('contBtn').disabled=false;
    }
  </script>

  <% } else if(step === 'you') { %>
  <div class="setup-mascot">🦉</div>
  <h1 class="setup-title">Tell us about you, <%= user.name.split(' ')[0] %>!</h1>
  <p class="setup-sub">Build your avatar and answer a couple quick questions. We'll use this to personalize your targets (sleep, water) and how much we throw at you at once.</p>

  <form method="POST" action="/setup/you" id="youForm">
    <div class="avatar-builder" id="avatarBuilder" style="--av-skin:#F0B594;--av-hair:#3B2314;--av-shirt:#5B8DEF;">
      <div class="avatar-preview">
        <div id="avPreviewMale"><%- include('partials/avatar', { gender: 'male', size: 140 }) %></div>
        <div id="avPreviewFemale" hidden><%- include('partials/avatar', { gender: 'female', size: 140 }) %></div>
      </div>

      <div class="avatar-opt-group">
        <label>I am...</label>
        <div class="avatar-gender-toggle">
          <button type="button" class="avatar-gender-btn active" data-gender="male" id="genderMaleBtn">🙋‍♂️ A guy</button>
          <button type="button" class="avatar-gender-btn" data-gender="female" id="genderFemaleBtn">🙋‍♀️ A girl</button>
        </div>
        <input type="hidden" name="gender" id="genderInput" value="male">
      </div>

      <div class="avatar-opt-group">
        <label>Skin tone</label>
        <div class="swatch-row" id="skinSwatches">
          <% ['#FDE0C4','#F0B594','#C88A5E','#8D5A3C','#5C3A24'].forEach(function(c, i){ %>
            <button type="button" class="swatch <%= i===1?'active':'' %>" data-val="<%= c %>" style="background:<%= c %>" aria-label="Skin tone"></button>
          <% }) %>
        </div>
        <input type="hidden" name="skin" id="skinInput" value="#F0B594">
      </div>

      <div class="avatar-opt-group">
        <label>Hair color</label>
        <div class="swatch-row" id="hairSwatches">
          <% ['#0F0A08','#3B2314','#8B5A2B','#C99A3D','#B0B0B0'].forEach(function(c, i){ %>
            <button type="button" class="swatch <%= i===1?'active':'' %>" data-val="<%= c %>" style="background:<%= c %>" aria-label="Hair color"></button>
          <% }) %>
        </div>
        <input type="hidden" name="hair" id="hairInput" value="#3B2314">
      </div>

      <div class="avatar-opt-group">
        <label>Shirt color</label>
        <div class="swatch-row" id="shirtSwatches">
          <% ['#5B8DEF','#FF5A5F','#10B981','#8B5CF6','#64748B'].forEach(function(c, i){ %>
            <button type="button" class="swatch <%= i===0?'active':'' %>" data-val="<%= c %>" style="background:<%= c %>" aria-label="Shirt color"></button>
          <% }) %>
        </div>
        <input type="hidden" name="shirt" id="shirtInput" value="#5B8DEF">
      </div>
    </div>

    <div class="form-row" style="max-width:420px;margin:0 auto 32px;">
      <div class="fg">
        <label for="ageInput">Your age (optional)</label>
        <input type="number" id="ageInput" name="age" min="10" max="110" placeholder="e.g. 21" class="form-inp">
      </div>
      <div class="fg">
        <label for="weightInput">Weight in kg (optional)</label>
        <input type="number" id="weightInput" name="weight_kg" min="20" max="300" step="0.1" placeholder="e.g. 65" class="form-inp">
      </div>
    </div>
    <p style="font-size:12px;color:var(--text-muted);text-align:center;margin-top:-24px;margin-bottom:32px;">We only use this to suggest a healthy sleep range and daily water goal. Never shown to anyone else.</p>

    <div class="fg">
      <label>How active are you day-to-day?</label>
      <select name="activity_level" class="form-inp" style="max-width:320px;margin:0 auto 32px;display:block;">
        <option value="sedentary">Mostly sedentary (desk job, little exercise)</option>
        <option value="lightly_active" selected>Lightly active (some walking/light exercise)</option>
        <option value="active">Active (regular exercise most weeks)</option>
        <option value="very_active">Very active (intense exercise most days)</option>
      </select>
    </div>

    <div class="fg">
      <label>How on top of your routines are you these days?</label>
      <div class="experience-grid">
        <label class="experience-card">
          <input type="radio" name="experience_level" value="beginner">
          <span class="experience-emoji">🌱</span>
          <span class="experience-title">Just starting out</span>
          <span class="experience-desc">New to tracking things, keep it simple</span>
        </label>
        <label class="experience-card">
          <input type="radio" name="experience_level" value="intermediate" checked>
          <span class="experience-emoji">🌿</span>
          <span class="experience-title">Somewhere in between</span>
          <span class="experience-desc">I've got some habits going already</span>
        </label>
        <label class="experience-card">
          <input type="radio" name="experience_level" value="experienced">
          <span class="experience-emoji">🌳</span>
          <span class="experience-title">Pretty on top of it</span>
          <span class="experience-desc">Give me everything at once</span>
        </label>
      </div>
    </div>

    <div class="setup-actions">
      <a href="/setup" class="btn-back-setup">← Back</a>
      <button type="submit" class="btn-launch"><i class="fas fa-arrow-right"></i> Continue</button>
    </div>
  </form>
  <script>
  (function() {
    var builder = document.getElementById('avatarBuilder');
    var maleBtn = document.getElementById('genderMaleBtn');
    var femaleBtn = document.getElementById('genderFemaleBtn');
    var maleAv = document.getElementById('avPreviewMale');
    var femaleAv = document.getElementById('avPreviewFemale');
    var genderInput = document.getElementById('genderInput');

    function setGender(g) {
      genderInput.value = g;
      maleBtn.classList.toggle('active', g === 'male');
      femaleBtn.classList.toggle('active', g === 'female');
      maleAv.hidden = g !== 'male';
      femaleAv.hidden = g !== 'female';
    }
    maleBtn.addEventListener('click', function() { setGender('male'); });
    femaleBtn.addEventListener('click', function() { setGender('female'); });

    function wireSwatches(containerId, inputId, cssVar) {
      var container = document.getElementById(containerId);
      var input = document.getElementById(inputId);
      container.querySelectorAll('.swatch').forEach(function(sw) {
        sw.addEventListener('click', function() {
          container.querySelectorAll('.swatch').forEach(function(s) { s.classList.remove('active'); });
          sw.classList.add('active');
          var val = sw.dataset.val;
          input.value = val;
          builder.style.setProperty(cssVar, val);
        });
      });
    }
    wireSwatches('skinSwatches', 'skinInput', '--av-skin');
    wireSwatches('hairSwatches', 'hairInput', '--av-hair');
    wireSwatches('shirtSwatches', 'shirtInput', '--av-shirt');
  })();
  </script>

  <% } else if(step === 'modules') { %>
  <div class="role-badge-top">
    <span class="role-badge"><i class="fas fa-user"></i> <%= user.role %></span>
  </div>
  <h1 class="setup-title"><i class="fas fa-puzzle-piece"></i> Customize Your Workspace</h1>
  <p class="setup-sub">
    <% if(user.experience_level === 'beginner') { %>
      We kept this short since you're just starting out. You can always turn more on later from Settings.
    <% } else { %>
      We've recommended modules based on your role. Toggle them to fit your needs.
    <% } %>
  </p>
  <p class="selected-count">Selected: <span id="selCount"><%= recommended.length %></span> modules</p>

  <form method="POST" action="/setup/modules" id="modForm">
    <div class="mod-grid">
      <% modules.forEach(function(mod){ %>
      <% const isRec = recommended.includes(mod.id); %>
      <div class="mod-toggle-card <%= isRec ? 'on' : '' %>" id="mcard_<%= mod.id %>">
        <% if(isRec){ %><div class="rec-badge">Recommended</div><% } %>
        <div class="mod-top">
          <div class="mod-icon-sm">
            <%- mod.slug==='tasks'?'<i class="fas fa-tasks"></i>':mod.slug==='study'?'<i class="fas fa-book-open"></i>':mod.slug==='finance'?'<i class="fas fa-money-bill-wave"></i>':mod.slug==='health'?'<i class="fas fa-heart"></i>':mod.slug==='notes'?'<i class="fas fa-sticky-note"></i>':mod.slug==='calendar'?'<i class="fas fa-calendar-alt"></i>':mod.slug==='reminders'?'<i class="fas fa-clock"></i>':mod.slug==='alarms'?'<i class="fas fa-bell"></i>':mod.slug==='subjects'?'<i class="fas fa-book"></i>':mod.slug==='habits'?'<i class="fas fa-fire"></i>':mod.slug==='screentime'?'<i class="fas fa-mobile-alt"></i>':mod.slug==='journal'?'<i class="fas fa-pen"></i>':mod.slug==='goals'?'<i class="fas fa-bullseye"></i>':mod.slug==='reports'?'<i class="fas fa-chart-line"></i>':'<i class="fas fa-pencil-alt"></i>' %>
          </div>
          <div class="mod-info-sm">
            <h4><%= mod.name %></h4>
            <p><%= mod.description %></p>
          </div>
        </div>
        <div class="toggle-row">
          <label class="toggle-switch">
            <input type="checkbox" name="modules" value="<%= mod.id %>" <%= isRec ? 'checked' : '' %> onchange="updateCount()">
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="setup-actions">
      <a href="/setup?step=you" class="btn-back-setup">← Back</a>
      <button type="submit" class="btn-launch"><i class="fas fa-rocket"></i> Launch Workspace</button>
    </div>
  </form>
  <script>
    function updateCount(){
      const c=document.querySelectorAll('input[name="modules"]:checked').length;
      document.getElementById('selCount').textContent=c;
      document.querySelectorAll('.mod-toggle-card').forEach(card=>{
        const cb=card.querySelector('input[type="checkbox"]');
        if(cb.checked) card.classList.add('on'); else card.classList.remove('on');
      });
    }
  </script>
  <% } %>
</div>
<%- include('footer') %>
