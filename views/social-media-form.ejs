<%- include('header', { currentPath: '/social-media' }) %>
<div class="page page-center">
  <a href="/social-media" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Social Media</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= log ? 'edit' : 'hashtag' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="socialMediaForm">
      <div class="form-row">
        <div class="fg">
          <label for="smDate">Date <span class="required">*</span></label>
          <input id="smDate" type="date" name="log_date" required value="<%= log ? new Date(log.log_date).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="fg">
          <label for="smPlatform">Platform <span class="required">*</span></label>
          <input id="smPlatform" type="text" name="platform" list="platformOptions" required placeholder="e.g. Instagram, YouTube, TikTok" value="<%= log ? log.platform : '' %>">
          <datalist id="platformOptions">
            <option value="Instagram"><option value="Facebook"><option value="YouTube">
            <option value="TikTok"><option value="X / Twitter"><option value="Snapchat"><option value="LinkedIn">
          </datalist>
        </div>
      </div>
      <div class="fg">
        <label for="smMinutes">Duration: <span class="live-val" id="smMinutesVal"><%= log ? log.minutes : 15 %></span> min <span class="required">*</span></label>
        <div class="quick-chip-row">
          <button type="button" class="quick-chip" data-target="smMinutes" data-val="10">10 min</button>
          <button type="button" class="quick-chip" data-target="smMinutes" data-val="30">30 min</button>
          <button type="button" class="quick-chip" data-target="smMinutes" data-val="60">1 hr</button>
          <button type="button" class="quick-chip" data-target="smMinutes" data-val="90">90 min</button>
        </div>
        <input id="smMinutes" type="range" name="minutes" min="5" max="300" step="5" required value="<%= log ? log.minutes : 15 %>" class="range-slider" data-live-label="smMinutesVal">
        <div class="slider-minmax"><span>5 min</span><span>5 hrs</span></div>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/social-media" id="cancelSocialMediaBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveSocialMediaBtn"><i class="fas fa-save" aria-hidden="true"></i> Save</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
