<%- include('header', { currentPath: '/tasks' }) %>
<%
  const currentTask = task || null;
  const action = typeof formAction !== 'undefined' ? formAction : '/tasks/create';
  const titleValue = currentTask ? currentTask.title : '';
  const descriptionValue = currentTask ? currentTask.description || '' : '';
  const submitText = typeof submitLabel !== 'undefined' ? submitLabel : 'Save Task';
%>
<div class="page page-center">
  <a href="/tasks/hub" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Tasks</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= currentTask ? 'edit' : 'plus-circle' %>" aria-hidden="true"></i>
      <h1><%= pageTitle || 'Create New Task' %></h1>
    </div>

    <form action="<%= action %>" method="POST" id="taskForm">
      <div class="fg">
        <label for="taskTitle">Task Title <span class="required">*</span></label>
        <input id="taskTitle" type="text" name="title" placeholder="What needs to be done?" required autofocus value="<%= titleValue %>">
      </div>

      <div class="form-row">
        <div class="fg">
          <label for="taskCategory">Category</label>
          <select id="taskCategory" name="category_id">
            <option value="">No Category</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat.id %>" <%= currentTask && String(currentTask.category_id) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="fg">
          <label>Priority</label>
          <div class="pill-picker">
            <input type="radio" id="prioLow" name="priority" value="low" <%= currentTask && currentTask.priority === 'low' ? 'checked' : '' %>>
            <label class="pill-option" for="prioLow"><i class="fas fa-arrow-down" style="color:#10b981;" aria-hidden="true"></i> Low</label>
            <input type="radio" id="prioMedium" name="priority" value="medium" <%= !currentTask || currentTask.priority === 'medium' ? 'checked' : '' %>>
            <label class="pill-option" for="prioMedium"><i class="fas fa-minus" style="color:#f59e0b;" aria-hidden="true"></i> Medium</label>
            <input type="radio" id="prioHigh" name="priority" value="high" <%= currentTask && currentTask.priority === 'high' ? 'checked' : '' %>>
            <label class="pill-option" for="prioHigh"><i class="fas fa-arrow-up" style="color:#ef4444;" aria-hidden="true"></i> High</label>
          </div>
        </div>
      </div>
      
      <div class="fg">
        <label>Difficulty Level</label>
        <div class="pill-picker">
          <input type="radio" id="diffEasy" name="difficulty" value="easy" <%= currentTask && currentTask.difficulty === 'easy' ? 'checked' : '' %>>
          <label class="pill-option" for="diffEasy"><span class="pill-emoji">🟢</span> Easy</label>
          <input type="radio" id="diffNormal" name="difficulty" value="normal" <%= !currentTask || currentTask.difficulty === 'normal' ? 'checked' : '' %>>
          <label class="pill-option" for="diffNormal"><span class="pill-emoji">🟡</span> Normal</label>
          <input type="radio" id="diffHard" name="difficulty" value="hard" <%= currentTask && currentTask.difficulty === 'hard' ? 'checked' : '' %>>
          <label class="pill-option" for="diffHard"><span class="pill-emoji">🔴</span> Hard</label>
        </div>
      </div>

      <div class="fg">
        <label>Time Availability</label>
        <div class="pill-picker">
          <input type="radio" id="availFlexible" name="availability" value="flexible" <%= !currentTask || currentTask.availability === 'flexible' ? 'checked' : '' %>>
          <label class="pill-option" for="availFlexible"><span class="pill-emoji">🌤️</span> Flexible</label>
          <input type="radio" id="availUrgent" name="availability" value="urgent" <%= currentTask && currentTask.availability === 'urgent' ? 'checked' : '' %>>
          <label class="pill-option" for="availUrgent"><span class="pill-emoji">⚡</span> Urgent</label>
          <input type="radio" id="availWeekend" name="availability" value="weekend" <%= currentTask && currentTask.availability === 'weekend' ? 'checked' : '' %>>
          <label class="pill-option" for="availWeekend"><span class="pill-emoji">🌅</span> Weekend</label>
        </div>
      </div>

      <div class="fg">
        <label for="taskDueDate">Due Date (optional)</label>
        <input id="taskDueDate" type="date" name="due_date" value="<%= currentTask && currentTask.due_date ? new Date(currentTask.due_date).toISOString().slice(0,10) : '' %>">
      </div>

      <div class="fg">
        <label for="taskDesc">Description (Optional)</label>
        <textarea id="taskDesc" name="description" placeholder="Add details, links, or notes here..." rows="4"><%= descriptionValue %></textarea>
      </div>

      <div class="form-actions">
        <a href="/tasks/hub" class="btn secondary"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button type="submit" class="btn primary">
          <i class="fas fa-save" aria-hidden="true"></i> <%= submitText %>
        </button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
