<%- include('header', { currentPath: '/water' }) %>
<div class="page">
  <div class="top">
    <div>
      <a href="/modules/health" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Health &amp; Wellness</a>
      <h1><i class="fas fa-tint" aria-hidden="true"></i> Water Intake</h1>
      <div class="page-desc">Record and monitor your daily water intake.</div>
    </div>
  </div>

  <div class="water-summary">
    <div>
      <div class="summary-tile" style="border:none;box-shadow:none;padding:0;">
        <div class="val"><%= todayTotal %> / <%= goal %> ml</div>
        <div class="lbl">Today's Progress (<%= progress %>%)</div>
      </div>
      <div class="progress-track" style="max-width:320px;margin-top:10px;">
        <div class="progress-fill" style="width:<%= progress %>%"></div>
      </div>
    </div>
    <div class="water-tap-row">
      <% [
        { ml: 150, emoji: '🥃', label: 'Glass' },
        { ml: 250, emoji: '🥤', label: 'Cup' },
        { ml: 500, emoji: '🍶', label: 'Bottle' },
        { ml: 1000, emoji: '💧', label: 'Big Bottle' }
      ].forEach(function(opt){ %>
      <form method="POST" action="/water/create" style="display:contents;">
        <input type="hidden" name="log_date" value="<%= new Date().toISOString().slice(0,10) %>">
        <input type="hidden" name="amount_ml" value="<%= opt.ml %>">
        <button type="submit" class="water-tap-btn" id="waterTap<%= opt.ml %>">
          <span class="water-tap-emoji"><%= opt.emoji %></span>
          <span class="water-tap-label"><%= opt.label %></span>
          <span class="water-tap-amt"><%= opt.ml %>ml</span>
        </button>
      </form>
      <% }) %>
    </div>
    <button type="button" class="water-custom-toggle" data-toggle-target="waterCustomForm">Or log a custom amount <i class="fas fa-chevron-down" aria-hidden="true"></i></button>
    <form method="POST" action="/water/create" class="water-quick-form" id="waterCustomForm" hidden>
      <input type="hidden" name="log_date" value="<%= new Date().toISOString().slice(0,10) %>">
      <div class="fg" style="flex:1;min-width:200px;margin-bottom:0;">
        <label for="waterCustomAmt">Amount: <span class="live-val" id="waterCustomVal">300</span> ml</label>
        <input id="waterCustomAmt" type="range" name="amount_ml" min="50" max="2000" step="50" value="300" class="range-slider" data-live-label="waterCustomVal">
      </div>
      <button type="submit" class="btn primary" id="addWaterBtn"><i class="fas fa-plus" aria-hidden="true"></i> Add</button>
    </form>
  </div>

  <% if(logs.length){ %>
  <div class="list">
    <% logs.forEach(log => { %>
    <div class="item">
      <div class="item-body">
        <div class="item-title"><i class="fas fa-tint" aria-hidden="true" style="color:var(--secondary);"></i> <%= log.amount_ml %> ml</div>
        <div class="meta">
          <i class="fas fa-calendar-day" aria-hidden="true"></i> <%= new Date(log.log_date).toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric'}) %>
          <% if(log.logged_at){ %><span><i class="fas fa-clock" aria-hidden="true"></i> <%= log.logged_at.slice(0,5) %></span><% } %>
        </div>
      </div>
      <div class="actions">
        <a href="/water/edit/<%= log.id %>" class="btn secondary btn-sm" id="editWater<%= log.id %>"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
        <form method="POST" action="/water/delete/<%= log.id %>" style="display:inline" onsubmit="return confirm('Delete this water log?');">
          <button type="submit" class="btn danger btn-sm" id="deleteWater<%= log.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-tint" aria-hidden="true"></i></div>
    <h3>No water logged yet</h3>
    <p>Use the quick-add form above to log your first glass of water.</p>
  </div>
  <% } %>
</div>
<%- include('footer') %>
